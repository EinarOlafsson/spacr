  "private_helper_docs": [
    {
      "canonical_id": "spacr.measure._otsu_by_label",
      "kind": "private_helper",
      "file": "spacr/measure.py",
      "callable_line": 4394,
      "source_line": 4395,
      "source_sha256": "254dc302e45a01c3facb02c235241cbc4bd86b38264339c4c40be70d592e2dc3",
      "source": "Observed-value Otsu thresholds per label, with the first maximum winning.\n\n:param flat: positive integer label index for each foreground pixel.\n:param values: real intensities of those pixels.\n:param presorted: optional :func:`_sorted_by_label` result for ``values``.\n:returns: one threshold per label index; 0 for a constant object or an\n    absent label. Integer data follow :func:`mahotas.thresholding.otsu`.\n\nAll candidate splits are evaluated together from sorted cumulative sums;\na split places values equal to its threshold in the lower class.\nCentring and power-of-two scaling within each object keep the score\nstable across intensity scales. A segmented prefix scan keeps sums\nindependent of the intensity and size of earlier labels.",
      "records": "No records: private helper",
      "admission": "Private source documentation inventory only"
    }
  ],
