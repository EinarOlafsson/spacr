      ],
      "seek_attempts": 1
    },
    {
      "requested_audio_time": 32.67,
      "text": "Activate spacr-conda.",
      "audio": 32.67,
      "video": 32.67,
      "cues": [
        "Activate spacr-conda."
      ],
      "seek_attempts": 1
    },
    {
      "requested_audio_time": 37.085,
      "text": "Run the displayed Python command to see the environment path, and check that it is the environment you just created.",
      "audio": 37.085,
      "video": 37.085,
      "cues": [
