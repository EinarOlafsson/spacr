      ],
      "seek_attempts": 1
    },
    {
      "requested_audio_time": 52.265,
      "text": "Installing Python and spaCR in one command lets Conda resolve every package together, which is much faster than adding spaCR to an existing environment.",
      "audio": 52.265,
      "video": 52.265,
      "cues": [
        "Installing Python and spaCR in one command lets Conda resolve every package together, which is much faster than adding spaCR to an existing environment."
      ],
      "seek_attempts": 1
    },
    {
      "requested_audio_time": 59.53750000000001,
      "text": "Check the installed spaCR version and package location.",
