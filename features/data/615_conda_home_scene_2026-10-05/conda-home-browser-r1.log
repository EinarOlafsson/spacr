      ],
      "seek_attempts": 1
    },
    {
      "requested_audio_time": 44.097500000000004,
      "text": "Run conda list spacr to see the installed version and confirm that it comes from conda-forge.",
      "audio": 44.0975,
      "video": 44.0975,
