      "cues": [
        "Create an environment named spacr-conda with Python three point twelve and spaCR from conda-forge, using the displayed command."
      ],
      "seek_attempts": 1
    },
    {
      "requested_audio_time": 20.197499999999998,
      "text": "Choose another name if you already use that name for a different environment.",
      "audio": 20.197499,
