  "semantic_checks": {
    "spacr.qt.widgets.picture_export#0": "One rendered picture exported as PNG or one-page PDF; no multipage/vector claim.",
    "spacr.qt.widgets.picture_export#1": "QImage/QPixmap input is used rather than surrounding-widget capture. PNG retains pixel dimensions and dots-per-metre metadata; PDF embeds raster without vector conversion.",
    "spacr.qt.widgets.picture_export#2": "Width and height independently use max(1.0,pixels/dpi*25.4) millimetres. Target spans the zero-margin page. No microscope pixel-calibration dependency or aspect-ratio preservation claim is added.",
    "spacr.qt.widgets.picture_export#3": "Default DPI and suggested suffix originate from their named preferences; final menu PNG/PDF choice takes precedence.",
    "spacr.qt.widgets.picture_export.ask_where_to_save#0": "Cancelled save dialog returns the exact empty string.",
    "spacr.qt.widgets.picture_export.ask_where_to_save#1": "Dialog adds selected-filter suffix only when absent, retains an existing suffix here, and save_as later enforces the menu-selected format.",
    "spacr.qt.widgets.picture_export.install_picture_save#2": "picture() runs before choose_format/menu; its returned image is used later, with no callback refresh immediately before write. No immutable/deep-copy snapshot guarantee is inferred.",
    "spacr.qt.widgets.picture_export.install_picture_save#3": "Callable stem is evaluated after successful format choice and before save_as opens the path dialog."
  },
