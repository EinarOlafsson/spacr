  "ownership": "qt_ci: in-app updater and Windows. colour_wave: macOS/Linux. Root: feature spec/index/progress, eventual authorized integration.",
  "current_in_app_flow": [
    "The Qt update check refuses an editable checkout or active analyses, asks for confirmation, then discovers old installations in a worker.",
    "OldInstallsDialog lists installer-owned roots for automatic removal and makes user-created environments optional. It has no cache contents or cleanup choice.",
    "For an ordinary Python environment, the updater pins the offered release, verifies distribution metadata in a fresh isolated process, saves the current module and settings, and requests a cooperative restart using the same Python.",
    "For a running Windows online install, a detached helper waits for the old process, downloads the checksum-verified NSIS installer, removes discovered installer roots, invokes a silent reinstall at the same root, and relaunches pythonw plus the application script.",
    "Frozen Windows offline copies lack a verified replacement adapter. The current updater refuses that family before deletion and asks for the matching installer; this is an unsupported path, not proof of a falsely successful update."
  ],
  "windows_flow": [
    "NSIS is per-user, remembers the registered install root, provides optional account and privacy choices in its window, and passes its exact build version to PowerShell.",
    "PowerShell gives PackageSpec and SPACR_PACKAGE_SPEC priority over deriving spacr==$Version. SPACR_OFFLINE_BUNDLE overrides the package and backend again.",
    "Bootstrap Python and uv download outside the old root before cleanup. Cleanup deletes the old roots before dependency installation, pip check, staged import validation and activation.",
    "Validation imports in isolated mode and prints spaCR version, but does not compare it with the requested release. NSIS subsequently writes its requested DisplayVersion and exact private-Python desktop and Start Menu shortcuts.",
    "The generated application script, command launcher and normal restart inherit the environment and do not use isolated mode. Their import context therefore differs from the validation probe.",
    "The frozen installer replaces _internal, copies the current bundled files, and creates an all-users Start Menu shortcut. The discovery helper only checks the per-user Start Menu and standard Program Files roots."
  ],
  "findings": [
    {
      "id": "WIN01",
      "kind": "proven conditional stale-version source path",
      "severity": "high",
      "summary": "Requested new version can silently install an older runtime when an inherited SPACR_PACKAGE_SPEC pins an older release or SPACR_OFFLINE_BUNDLE contains an older bundle. Validation only prints the runtime version; NSIS registers the requested version regardless. This source path was not executed on Windows.",
      "references": [
        "packaging/online/install_spacr_windows.ps1:55-78",
        "packaging/online/install_spacr_windows.ps1:227-237",
        "packaging/online/spacr_online_installer.nsi:137-154"
      ],
      "future_fix": "Separate explicit development overrides from a released installer target. Reject conflicting inherited pins or bundles before mutation, or require a clearly labeled explicit choice. Verify the final runtime against the requested release."
    },
    {
      "id": "UPD01",
      "kind": "proven verification gap",
      "severity": "high",
      "summary": "The generic replacement helper trusts installer exit 0 and relaunches without checking the destination runtime version or imported code path. run_pip_upgrade checks fresh metadata only.",
      "references": [
        "spacr/install_cleanup.py:3123-3227",
        "spacr/updater.py:654-662",
        "spacr/version.py:69-90"
      ],
      "future_fix": "Require a fresh identity receipt containing distribution version, facade version, get_version(), spacr.__file__, sys.executable and sys.prefix. Check the destination root and actual relaunched GUI before reporting success."
    },
    {
      "id": "CACHE01",
      "kind": "proven default-deletion policy mismatch",
      "severity": "high",
      "summary": "Default removal deletes the entire installer root. Windows only keeps its current log, icon and status file, so root/cache and root/test_data disappear. Recursive deletion honors explicit keep paths but does not re-run user-data refusal checks for children. Existing tests expect this deletion.",
      "references": [
        "spacr/install_cleanup.py:1379-1433",
        "spacr/install_cleanup.py:1129-1170",
        "packaging/online/install_spacr_windows.ps1:86-92,198-202",
        "tests/test_install_cleanup.py:329-337,460-481"
      ],
      "future_fix": "Separate the owned application runtime inventory from persistent cache and data. Keep caches, test data and unknown user files by default; delete only necessary, validated installer staging paths."
    },
    {
      "id": "CACHE02",
      "kind": "proven configured-data preservation gap",
      "severity": "high",
      "summary": "Standard ~/.spacr, HF_HOME and XDG locations are protected, but custom SPACR_HOME, CELLPOSE_LOCAL_MODELS_PATH, SPACR_BACKENDS_DIR and relocated caches are not all included in normal preservation. A configured folder inside an installer root can be deleted during recursive removal.",
      "references": [
        "spacr/install_cleanup.py:1056-1073",
        "spacr/install_cleanup.py:1098-1127",
        "spacr/install_cleanup.py:1190-1213",
        "packaging/online/install_spacr_windows.ps1:284-296"
      ],
      "future_fix": "Resolve configured protected folders and real paths before preparing the removal plan. Preserve nested user folders and validate junctions, symlinks, ownership and shared locations."
    },
    {
      "id": "GUI01",
      "kind": "proven missing requested product flow",
      "severity": "medium",
      "summary": "Optional cleanup is currently a terminal purge. It lists folder paths, requires terminal input and mixes caches with logs, runs, models, backends, preferences and other user data. No default-off GUI selection with folder contents exists.",
      "references": [
        "packaging/online/spacr_online_installer.nsi:184-191",
        "spacr/install_cleanup.py:1217-1255",
        "spacr/install_cleanup.py:1308-1351",
        "spacr/qt/app.py:5191-5233"
      ],
      "future_fix": "Add a separate cache-only GUI choice, off by default, showing contents, count, size, purpose and exact selected folders. Keep analysis data and preferences separate and protected. Keep the legacy CLI purge distinct."
    },
    {
      "id": "DISC01",
      "kind": "proven incomplete discovery, actual staleplatformsymptom unconfirmed",
      "severity": "medium",
      "summary": "Windows discovery reads the current HKCU root and default LOCALAPPDATA roots; frozen discovery checks standard Program Files directories. Arbitrary historical custom roots and all-users Start Menu links can escape discovery. User environments remain untouched unless selected.",
      "references": [
        "spacr/install_cleanup.py:673-679",
        "spacr/install_cleanup.py:698-760",
        "spacr/install_cleanup.py:760-785",
        "packaging/build_windows.ps1:62-79",
        "spacr/install_cleanup.py:991-1051"
      ],
      "future_fix": "Discover owned installation history and native shortcut targets, and audit actual command resolution. Repair only owned links or PATH entries. Present user-created environments as optional choices rather than automatically deleting them."
    },
    {
      "id": "LAUNCH01",
      "kind": "proven non-isolated launch vs isolated validation mismatch; symptom unconfirmed",
      "severity": "medium",
      "summary": "Validation uses -I, while normal launches inherit PYTHONPATH and user-site behavior. An old import path may therefore remain active after the isolated version check succeeds. Explicit interpreter and shortcut paths reduce PATH ambiguity but do not prove import identity.",
      "references": [
        "spacr/updater.py:654-661",
        "spacr/updater.py:666-674",
        "spacr/restart_state.py:395-408",
        "spacr/install_cleanup.py:2779-2803",
        "packaging/online/install_spacr_windows.ps1:315-322",
        "packaging/online/spacr_online_installer.nsi:158-174"
      ],
      "future_fix": "Use consistent import rules for owned launchers and verify the actual GUI identity. Add tests for PYTHONPATH shadowing, user-site copies and competing package metadata."
    },
    {
      "id": "ROLL01",
      "kind": "proven failure-recovery gap",
      "severity": "medium",
      "summary": "Old application roots are deleted before new dependencies and runtime validation finish. A later failure can leave no old working runtime, despite the staging and .venv-previous activation code. The existing staging test misses this earlier deletion.",
      "references": [
        "packaging/online/install_spacr_windows.ps1:198-225",
        "packaging/online/install_spacr_windows.ps1:264-281",
        "tests/test_online_installers.py:170-179"
      ],
      "future_fix": "Validate a staged replacement before removing the old runtime. Retain a rollback copy until the new launch is verified, while preserving persistent folders throughout."
    },
    {
      "id": "TMP01",
      "kind": "proven temporary ownership scope",
      "severity": "low",
      "summary": "PowerShell uses a temporary folder tied to its process and cleans it in finally. NSIS uses a static TEMP/spaCR-online-installer folder and only cleans it on successful completion; failed invocations can leave it behind.",
      "references": [
        "packaging/online/install_spacr_windows.ps1:128-131,327-337",
        "packaging/online/spacr_online_installer.nsi:99-104,162-166"
      ],
      "future_fix": "Use a unique invocation-owned bootstrap folder and a manifest. Remove only necessary owned transient files on success or failure; keep diagnostic logs and unrelated temporary files."
    }
  ],
