  "navigation_probe_source": "import ast\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport time\nfrom PySide6.QtWidgets import QApplication, QWidget\nfrom PySide6.QtTest import QTest\n\nfrom spacr.qt.preferences import apply_preferences_to_app\nfrom spacr.qt import register_self_registering_modules, iconset\nfrom spacr.qt.app import MainWindow, install_the_dialog_filters, _load_bundled_fonts, _use_open_sans\n\narm = sys.argv[1]\nif arm == 'before':\n    source = Path(__file__).with_name('iconset-before.py').read_text()\n    function = next(node for node in ast.parse(source).body if isinstance(node, ast.FunctionDef) and node.name == 'icon')\n    exec(compile(ast.Module(body=[function], type_ignores=[]), '<original icon>', 'exec'), iconset.__dict__)\napp = QApplication([])\n_load_bundled_fonts()\n_use_open_sans(app)\napply_preferences_to_app(app)\ninstall_the_dialog_filters(app)\nregister_self_registering_modules()\nwindow = MainWindow()\nwindow.resize(1366, 768)\nwindow.show()\nQTest.qWait(200)\nstarted = time.perf_counter()\nwindow._on_nav_selected('classify_merged')\napp.processEvents()\nelapsed = (time.perf_counter() - started) * 1000\nscreen = window._screens['classify_merged']\nqta = sys.modules.get('qtawesome')\nshared = getattr(qta, '_resource', {}).get('iconic')\nproviders = getattr(app, '_spacr_glyph_providers', {})\nrecord = {'arm': arm, 'open_ms': elapsed,\n    'widgets': len(screen.findChildren(QWidget)),\n    'qtawesome_version': getattr(qta, '__version__', None),\n    'global_font_families': list(shared.fontids) if shared is not None else [],\n    'local_font_families': [list(value[1].fontids) for value in providers.values()],\n    'source_sha256': hashlib.sha256(Path(iconset.__file__).read_bytes()).hexdigest()}\nprint(json.dumps(record), flush=True)\nwindow.close()\napp.processEvents()\n",
  "isolated_probe_source": "import ast\nimport json\nfrom pathlib import Path\nimport sys\nimport time\nfrom PySide6.QtWidgets import QApplication\nfrom spacr.qt import iconset\n\narm = sys.argv[1]\nif arm == 'before':\n    source = Path(__file__).with_name('iconset-before.py').read_text()\n    function = next(node for node in ast.parse(source).body if isinstance(node, ast.FunctionDef) and node.name == 'icon')\n    exec(compile(ast.Module(body=[function], type_ignores=[]), '<original icon>', 'exec'), iconset.__dict__)\napp = QApplication([])\nstarted = time.perf_counter()\nqta = iconset._try_qta()\nimport_ms = (time.perf_counter() - started) * 1000\nstarted = time.perf_counter()\nicon = iconset.icon('settings', color='#ffffff')\nimage = icon.pixmap(32, 32).toImage()\ncreate_and_render_ms = (time.perf_counter() - started) * 1000\nassert not icon.isNull() and not image.isNull()\nprint(json.dumps({'arm': arm, 'import_ms': import_ms, 'create_and_render_ms': create_and_render_ms}), flush=True)\n",
