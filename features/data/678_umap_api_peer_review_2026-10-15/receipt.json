  "resolved_findings": [
    {
      "language": "sv",
      "label": "spacr.qt.widgets.umap_figure_settings#3",
      "old_target": "``TIER_STYLE`` kan ställas in på befintliga grafiska objekt: punktstorlek, punktfärg, opacitet och konturbredd. Mikrosekunder; inget läses om från disk. ``TIER_REDRAW`` kräver att figuren ritas om, men **från samma inbäddning**: bildantal, bildzoom, figurstorlek och vilka lager som ritas. Tiondelar av en sekund eftersom miniatyrerna läses om; därför inväntas en kort paus mellan ändringarna. ``TIER_RERUN`` sparas för en senare körning i stället för att tillämpas på den färdiga figuren. Denna nivå omfattar ``n_neighbors``, ``min_dist``, avståndsmåttet och funktionsfiltret samt alternativ för klustring, vylayout och utdata. Alla inställningar på denna nivå ändrar inte inbäddningens koordinater. Den omgivande dialogrutan kan kopiera dessa värden till modulen med åtgärden Propagate settings när ett återanrop för överföring finns.",
      "new_target": "``TIER_STYLE`` kan ställas in på befintliga grafiska objekt: punktstorlek, punktfärg, opacitet och konturbredd. Mikrosekunder; inget läses om från disk. ``TIER_REDRAW`` kräver att figuren ritas om, men **från samma inbäddning**: bildantal, bildzoom, figurstorlek och vilka lager som ritas. Tiondelar av en sekund eftersom miniatyrerna läses om; därför inväntas en kort paus mellan ändringarna. ``TIER_RERUN`` sparas för en senare körning i stället för att tillämpas på den färdiga figuren. Denna nivå omfattar ``n_neighbors``, ``min_dist``, avståndsmåttet och egenskapsfiltret samt alternativ för klustring, vylayout och utdata. Inte alla inställningar på denna nivå ändrar inbäddningens koordinater. Den omgivande dialogrutan kan kopiera dessa värden till modulen med åtgärden Propagate settings när ett återanrop för överföring finns.",
      "old_target_sha256": "3d6bede596fc94e129b73f4fc24923106c5fb02d477fbd0349ea6f20e8bf41d4",
      "new_target_sha256": "1d85cf2e5523a358299c5bc69bf7718479d2db46556e76d7fdcfac474875977f",
      "reason": "Use egenskapsfiltret for feature filter, rather than funktionsfiltret; use Inte alla... for unambiguous not-every coordinate-change quantifier."
    }
  ],
  "semantic_checks": {
    "spacr.qt.widgets.umap_figure_settings#3": "Existing artist styling versus redraw from the same embedding; retains microsecond/tenths-of-second prose without turning it into a new measured guarantee. Rerun tier includes clustering/view/output and does not always change coordinates; dialog copies values only when its optional propagation callback exists.",
    "spacr.qt.widgets.umap_figure_settings#4": "Each field declares its panel application tier.",
    "spacr.qt.widgets.umap_figure_settings.Field#3": "All six kind literals retained, including int_or_none; nullable integer uses QLineEdit and _int_or_none parser.",
    "spacr.qt.widgets.umap_figure_settings.UmapFigureSettings#1": "Complete settings dictionary emitted after debounce; style/redraw applied without separate Apply action; rerun values do not change current figure and may be propagated for later run."
  },
