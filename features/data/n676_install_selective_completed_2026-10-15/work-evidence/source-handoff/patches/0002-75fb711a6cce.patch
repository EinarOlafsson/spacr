diff --git a/tools/tutorials/retain_narration.py b/tools/tutorials/retain_narration.py
index 9835030846cf129ba1ea5c3caf59b35c5ca52bb4..e1f4acb0e9e2b107acfeb1b38071d2f58f1cd2e7 100644
--- a/tools/tutorials/retain_narration.py
+++ b/tools/tutorials/retain_narration.py
@@ -32,7 +32,16 @@ def catalog_lesson(path, lesson_id):
     return matches[0]
 
 
-def require_unchanged_lesson(original, published, staged):
+def require_unchanged_lesson(original, published, staged, *, voice_inventory=None):
+    if original != published and voice_inventory is not None and published == staged:
+        previous = original.get('narration_voices', {})
+        if (isinstance(previous, dict) and published.get('narration_voices') == voice_inventory
+                and all(language in voice_inventory and isinstance(voices, list)
+                        and all(isinstance(voice, str) for voice in voices)
+                        and len(voices) == len(set(voices))
+                        and set(voices) <= set(voice_inventory[language])
+                        for language, voices in previous.items())):
+            original = {**original, 'narration_voices': voice_inventory}
     if original != published or original != staged:
         raise ValueError('Retained catalog differs from original or published lesson')
 
@@ -59,7 +68,7 @@ def retained_sources(stage, original, baseline, lesson_id, inventory, *, require
         source = catalog_lesson(original / 'catalog' / filename, lesson_id)
         published = catalog_lesson(baseline / filename, lesson_id)
         staged = catalog_lesson(stage / 'catalog' / filename, lesson_id)
-        require_unchanged_lesson(source, published, staged)
+        require_unchanged_lesson(source, published, staged, voice_inventory=inventory)
         catalogs.append({'language': language, 'lesson_sha256': hashlib.sha256(
             json.dumps(source, sort_keys=True, ensure_ascii=False).encode()).hexdigest()})
         for voice in inventory.get(language, []):
diff --git a/tools/tutorials/tests/test_retained_narration.py b/tools/tutorials/tests/test_retained_narration.py
index 5030dda4456a2ef56c746791fbd8cbe5f88d5cd9..511c5f26c35f72f247a9b4bf422a35352e52e71a 100644
--- a/tools/tutorials/tests/test_retained_narration.py
+++ b/tools/tutorials/tests/test_retained_narration.py
@@ -21,6 +21,39 @@ def test_equal_catalogs_pass_and_each_changed_source_fails():
             require_unchanged_lesson(*sources)
 
 
+@pytest.mark.parametrize('previous', [None, {'en': ['af_heart']}])
+def test_explicit_inventory_allows_only_generated_original_inventory_expansion(previous):
+    inventory = {'en': ['af_heart', 'am_adam'], 'fr': ['ff_siwis']}
+    original = {'id': 'lesson', 'scenes': [{'narration': 'Original.'}]}
+    if previous is not None:
+        original['narration_voices'] = previous
+    published = {**deepcopy(original), 'narration_voices': inventory}
+    require_unchanged_lesson(original, published, deepcopy(published), voice_inventory=inventory)
+    with pytest.raises(ValueError):
+        require_unchanged_lesson(original, published, deepcopy(published))
+    assert original.get('narration_voices') == previous
+
+
+@pytest.mark.parametrize('change', ['source_narration', 'published_extra', 'staged_inventory',
+                                  'published_inventory', 'old_unknown', 'old_duplicate', 'old_voice_type'])
+def test_explicit_inventory_never_allows_catalog_or_voice_drift(change):
+    inventory = {'en': ['af_heart', 'am_adam'], 'fr': ['ff_siwis']}
+    original = {'id': 'lesson', 'scenes': [{'narration': 'Original.'}],
+                'narration_voices': {'en': ['af_heart']}}
+    published = {**deepcopy(original), 'narration_voices': deepcopy(inventory)}
+    staged = deepcopy(published)
+    if change == 'source_narration': original['scenes'][0]['narration'] = 'Changed.'
+    if change == 'published_extra': published['extra'] = staged['extra'] = True
+    if change == 'staged_inventory': staged['narration_voices']['en'] = ['af_heart']
+    if change == 'published_inventory':
+        published['narration_voices']['en'] = staged['narration_voices']['en'] = ['af_heart']
+    if change == 'old_unknown': original['narration_voices'] = {'en': ['unknown']}
+    if change == 'old_duplicate': original['narration_voices'] = {'en': ['af_heart', 'af_heart']}
+    if change == 'old_voice_type': original['narration_voices'] = {'en': 'af_heart'}
+    with pytest.raises(ValueError):
+        require_unchanged_lesson(original, published, staged, voice_inventory=inventory)
+
+
 @pytest.fixture
 def timing():
     lesson = {'id': 'lesson', 'scenes': [{'narration': 'Original.'}]}
