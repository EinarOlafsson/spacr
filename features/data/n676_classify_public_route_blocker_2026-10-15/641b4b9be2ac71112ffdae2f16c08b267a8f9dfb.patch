+def run_ml_pipeline(screen, capture, settle, timeout, *, batch_clip=False, running_clip=False):
+    """Observe this physical ML Run without requiring its worker to survive."""
+    import time
+    import capture_ui
+    from capture_acceptance import observe_pipeline_run
+    from PySide6.QtCore import Qt
+    from PySide6.QtTest import QTest
+
+    def after_click():
+        if batch_clip:
+            capture_ui.wait(capture, 1.5, settle)
+            capture.end()
+        settle(1)
+        if running_clip:
+            capture_ui.wait(capture, 1.5, settle)
+            capture.end()
+        else:
+            capture('21_batch_running')
+
+    next_progress = time.monotonic() + 20
+    def waiting(seconds):
+        nonlocal next_progress
+        if time.monotonic() >= next_progress:
+            capture('22_batch_progress')
+            next_progress = time.monotonic() + 30
+        settle(seconds)
+
+    try:
+        return observe_pipeline_run(screen,
+            lambda: QTest.mouseClick(screen._btn_run, Qt.LeftButton),
+            waiting, timeout, after_click=after_click)
+    except TimeoutError:
+        if screen._worker_thread_is_running():
+            QTest.mouseClick(screen._btn_stop, Qt.LeftButton)
+            settle(3)
+        raise
+
+
