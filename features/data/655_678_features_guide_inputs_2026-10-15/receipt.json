  "source_manifest": {
    "schema": 1,
    "source_commit": "0289c7d9ca64d96bea454f50d4ec6fd8d38b8fe7",
    "source_file_sha256": "fb28dbdf1f9215a43d1a3fa0fdd7e97f5d64002a7cd5b34cc661d91f93bd3399",
