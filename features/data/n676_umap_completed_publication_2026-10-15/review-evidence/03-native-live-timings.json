{
  "schema": 1,
  "kind": "native_visual_timing",
  "native_live_video": true,
  "lesson": "15_image_umap",
  "fps": 30,
  "total_duration": 366.69999999999993,
  "scenes": [
    {
      "scene": 1,
      "speech_start": 0.0,
      "speech_end": 23.166666666666668,
      "scene_end": 23.166666666666668,
      "duration": 23.166666666666668,
      "text": "From Home, open Image UMAP. Use it to explore similarities between measured objects while viewing their image crops. Start with a project containing a measurements database and the crops saved by Measure.",
      "visual": "01_module",
      "longest_narration_duration": 18.794999999999998,
      "complete_native_duration": 23.166666666666668,
      "native_live_video": true
    },
    {
      "scene": 2,
      "speech_start": 23.166666666666668,
      "speech_end": 49.53333333333333,
      "scene_end": 49.53333333333333,
      "duration": 26.366666666666667,
      "text": "Under Source, choose Add project folders and select the example plate folder downloaded through Annotate. Review the available databases, rows and shared columns. You can add more project folders when you want to compare several datasets.",
      "visual": "19_setting_src",
      "longest_narration_duration": 21.970000000000002,
      "complete_native_duration": 26.366666666666667,
      "native_live_video": true
    },
    {
      "scene": 3,
      "speech_start": 49.53333333333333,
      "speech_end": 78.6,
      "scene_end": 78.6,
      "duration": 29.066666666666666,
      "text": "Choose the tables whose features you want to compare. For this example, select cell, cytoplasm, nucleus and pathogen measurements. Leave Resnet features off to use the existing measurements. Review missing-data and correlated-feature settings before running.",
      "visual": "19_setting_tables",
      "longest_narration_duration": 24.655,
      "complete_native_duration": 29.066666666666666,
      "native_live_video": true
    },
    {
      "scene": 4,
      "speech_start": 78.6,
      "speech_end": 101.03333333333333,
      "scene_end": 101.03333333333333,
      "duration": 22.433333333333334,
      "text": "Set Row limit to four hundred for a quick first view and use two workers. Row limit controls how many objects enter the embedding. Increase it when you are ready to explore more of the dataset.",
      "visual": "19_setting_row_limit",
      "longest_narration_duration": 18.015,
      "complete_native_duration": 22.433333333333334,
      "native_live_video": true
    },
    {
      "scene": 5,
      "speech_start": 101.03333333333333,
      "speech_end": 124.66666666666666,
      "scene_end": 124.66666666666666,
      "duration": 23.633333333333333,
      "text": "Choose UMAP as the reduction method. Each point will represent an object using two plotted coordinates.",
      "visual": "19_setting_reduction_method",
      "longest_narration_duration": 11.134999999999991,
      "complete_native_duration": 23.633333333333333,
      "native_live_video": true
    },
    {
      "scene": 6,
      "speech_start": 124.66666666666666,
      "speech_end": 147.63333333333333,
      "scene_end": 147.63333333333333,
      "duration": 22.966666666666665,
      "text": "Set Neighbours to fifteen and Minimum distance to zero point one. Neighbours controls the size of the neighbourhood used to build the map. Minimum distance controls how closely points can pack in the displayed embedding.",
      "visual": "19_setting_n_neighbors",
      "longest_narration_duration": 18.564999999999998,
      "complete_native_duration": 22.966666666666665,
      "native_live_video": true
    },
    {
      "scene": 7,
      "speech_start": 147.63333333333333,
      "speech_end": 169.43333333333334,
      "scene_end": 169.43333333333334,
      "duration": 21.8,
      "text": "Set Random seed to forty-two so repeated runs with the same inputs and settings are easier to compare. Save your chosen feature tables and preprocessing settings alongside the seed.",
      "visual": "19_setting_random_seed",
      "longest_narration_duration": 17.41500000000002,
      "complete_native_duration": 21.8,
      "native_live_video": true
    },
    {
      "scene": 8,
      "speech_start": 169.43333333333334,
      "speech_end": 193.63333333333333,
      "scene_end": 193.63333333333333,
      "duration": 24.2,
      "text": "Clustering assigns labels to groups after the embedding is built. This example uses DBSCAN with noise removal off. Inspect the crops within any group before using its label in a later analysis.",
      "visual": "19_setting_clustering",
      "longest_narration_duration": 19.795000000000016,
      "complete_native_duration": 24.2,
      "native_live_video": true
    },
    {
      "scene": 9,
      "speech_start": 193.63333333333333,
      "speech_end": 215.79999999999998,
      "scene_end": 215.79999999999998,
      "duration": 22.166666666666668,
      "text": "Enable Plot images and Plot points. Use twelve small crop images so the overview remains readable. You can inspect individual objects more closely in the interactive view after fitting.",
      "visual": "19_setting_plot_images",
      "longest_narration_duration": 17.75,
      "complete_native_duration": 22.166666666666668,
      "native_live_video": true
    },
    {
      "scene": 10,
      "speech_start": 215.79999999999998,
      "speech_end": 240.86666666666665,
      "scene_end": 240.86666666666665,
      "duration": 25.066666666666666,
      "text": "Press Run and watch the console for feature preparation and embedding progress. Wait for the completed result. If you change the input tables or reduction settings, run again to produce a new map.",
      "visual": "23_batch_finished",
      "longest_narration_duration": 20.655,
      "complete_native_duration": 25.066666666666666,
      "native_live_video": true
    },
    {
      "scene": 11,
      "speech_start": 240.86666666666665,
      "speech_end": 266.2,
      "scene_end": 266.2,
      "duration": 25.333333333333332,
      "text": "Inspect the embedding in Figures and open the results folder reported in the console. Keep the saved figure, selected measurement rows, metadata and cluster labels together so you can trace an interesting group back to its objects.",
      "visual": "24_batch_figure",
      "longest_narration_duration": 20.905,
      "complete_native_duration": 25.333333333333332,
      "native_live_video": true
    },
    {
      "scene": 12,
      "speech_start": 266.2,
      "speech_end": 290.59999999999997,
      "scene_end": 290.59999999999997,
      "duration": 24.4,
      "text": "Enable Interactive to explore the fitted map. Zoom into a region and click its points. The view uses the completed embedding, so you can inspect different objects without fitting it again.",
      "visual": "25_interactive_embedding",
      "longest_narration_duration": 19.974999999999994,
      "complete_native_duration": 24.4,
      "native_live_video": true
    },
    {
      "scene": 13,
      "speech_start": 290.59999999999997,
      "speech_end": 315.16666666666663,
      "scene_end": 315.16666666666663,
      "duration": 24.566666666666666,
      "text": "Click a point to show its crop in the side panel. Use the displayed object path to connect the image to its source record. Compare morphology across nearby points and across distant regions of the map.",
      "visual": "26_point_0",
      "longest_narration_duration": 20.155,
      "complete_native_duration": 24.566666666666666,
      "native_live_video": true
    },
    {
      "scene": 14,
      "speech_start": 315.16666666666663,
      "speech_end": 341.4333333333333,
      "scene_end": 341.4333333333333,
      "duration": 26.266666666666666,
      "text": "Click another point to compare its crop. The sidebar also provides selection labelling and cluster-label propagation. Those controls save annotations, so choose the intended label and selection before applying them.",
      "visual": "26_point_200",
      "longest_narration_duration": 21.84499999999997,
      "complete_native_duration": 26.266666666666666,
      "native_live_video": true
    },
    {
      "scene": 15,
      "speech_start": 341.4333333333333,
      "speech_end": 366.69999999999993,
      "scene_end": 366.69999999999993,
      "duration": 25.266666666666666,
      "text": "Review the completed embedding and compare the image crops of selected objects. Keep the input measurements, chosen settings and saved results together to trace each point back to its source.",
      "visual": "27_review_embedding",
      "longest_narration_duration": 17.189999999999998,
      "complete_native_duration": 25.266666666666666,
      "native_live_video": true
    }
  ],
