+                           ('/spacr/nightly', NIGHTLY_URL + '?q=1#x'),
+                           ('/spacr/nightlyish.html', 'null'),
+                           ('/spacr/missing.html', 'null')):
+        out = subprocess.run([node, '-e', probe.replace('PATH', repr(path))],
