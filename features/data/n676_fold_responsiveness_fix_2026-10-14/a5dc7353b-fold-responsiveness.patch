From a5dc7353bc1da39795c565dd4d4dd27f3f2ba5af Mon Sep 17 00:00:00 2001
From: Einar Olafsson <einar.olafsson@gmail.com>
Date: Wed, 14 Oct 2026 18:36:49 -0400
Subject: [PATCH] Keep cold folded page openings responsive and guard queued
 transitions

---
 spacr/qt/screens/__init__.py                  |   7 +-
 spacr/qt/screens/map_barcodes.py              |  95 ++++++++++++-
 ...fold_opening_keeps_the_event_loop_alive.py | 125 ++++++++++++++++++
 3 files changed, 222 insertions(+), 5 deletions(-)
 create mode 100644 tests/qt/test_fold_opening_keeps_the_event_loop_alive.py

diff --git a/spacr/qt/screens/__init__.py b/spacr/qt/screens/__init__.py
index 4f824f3730fd3d2b32b0af570630742a0fc16dcf..b1113549f03ebaada20666a7dab2c384d59b633a 100644
--- a/spacr/qt/screens/__init__.py
+++ b/spacr/qt/screens/__init__.py
@@ -36,10 +36,9 @@ _SECOND_PASS_AFTER_S = 0.1
 def _start_breathing_while_a_window_opens(started_at: float) -> None:
     """Allow breaths for the open that began at ``started_at``.
 
-    Called only by ``MainWindow._on_nav_selected``, which also holds back
-    any navigation that arrives during a breath. A screen built anywhere
-    else -- a test, a rebuild after a preference change, a folded panel --
-    is built in one piece exactly as before.
+    Called by normal navigation and a folded page's first click. Both hold
+    back navigation and user input during a breath. A direct screen build
+    outside those guarded routes remains synchronous.
 
     :param started_at: ``time.perf_counter()`` when the open began, which
         counts as the last breath.
diff --git a/spacr/qt/screens/map_barcodes.py b/spacr/qt/screens/map_barcodes.py
index e4dc6c4aeccb9315c4a2bfbad45947724ff3fb9e..14439e840f979a859c50e01eadf6d3680bb30f0c 100644
--- a/spacr/qt/screens/map_barcodes.py
+++ b/spacr/qt/screens/map_barcodes.py
@@ -557,9 +557,12 @@ def show_as_page(screen: QWidget, host: Optional[QWidget],
     :param title: page caption, normally the folded module's display name.
     :returns: ``screen``, or ``None`` when the host cannot contain pages.
     """
+    from . import _breathe_while_a_window_opens
+
     pages = host_pages(host) if host is not None else None
     if pages is None:
         return None
+    _breathe_while_a_window_opens(force=True)
     index = pages.indexOf(screen)
     if index < 0:
         index = pages.addTab(screen, title)
@@ -575,7 +578,9 @@ def show_as_page(screen: QWidget, host: Optional[QWidget],
                 pages.setTabIcon(index, icon)
         except Exception:                                # noqa: BLE001
             LOG.debug("no mark for the %s page", key, exc_info=True)
+    _breathe_while_a_window_opens(force=True)
     pages.setCurrentIndex(index)
+    _breathe_while_a_window_opens(force=True)
     return screen
 
 
@@ -609,9 +614,78 @@ class FoldOpener:
         #: callers that predate pages; it is a page on the host wherever
         #: the host can carry one.
         self.window: Optional[QWidget] = None
+        self._opening = False
+        self._deferred = False
+
+    def _open_after_current_fold(self) -> None:
+        """Retry a queued open only while its host is still alive."""
+        self._deferred = False
+        self.open()
 
     def open(self, _checked: bool = False) -> Optional[QWidget]:
-        """Show the folded module; raise it if it is already up."""
+        """Open the real page while keeping the host's event loop responsive.
+
+        Construction, the host body's reparenting, and selecting the new page
+        are separate layout steps. They use the same guarded event-loop breaths
+        as normal navigation, after each complete step; no page is built before
+        its first click. The existing page stays on show while the next one is
+        being built, and user input is excluded during these breaths.
+        """
+        if self._opening:
+            return self.window
+        import time
+        from . import _breathe_while_a_window_opens
+        from . import _start_breathing_while_a_window_opens
+        from . import _stop_breathing_while_a_window_opens
+        from . import _a_window_is_opening_a_screen
+
+        host_window = self.screen.window() if self.screen is not None else None
+        active_fold = getattr(host_window, "_opening_a_fold", None)
+        if active_fold is not None and active_fold is not self:
+            if not self._deferred:
+                from .. import _after
+
+                self._deferred = True
+                _after(0, self.screen, self._open_after_current_fold)
+            return self.window
+        had_fold_guard = hasattr(host_window, "_opening_a_fold")
+        had_guard = hasattr(host_window, "_opening_a_screen")
+        previous_guard = getattr(host_window, "_opening_a_screen", False)
+        owns_breaths = not _a_window_is_opening_a_screen
+        self._opening = True
+        if host_window is not None:
+            host_window._opening_a_screen = True
+            host_window._opening_a_fold = self
+        if owns_breaths:
+            _start_breathing_while_a_window_opens(time.perf_counter())
+        try:
+            from ..i18n import ui_language_resolved_once
+            from ..preferences import _one_store
+
+            with ui_language_resolved_once(), _one_store():
+                shown = self._open_page()
+                _breathe_while_a_window_opens(force=True)
+                return shown
+        finally:
+            try:
+                if owns_breaths:
+                    _stop_breathing_while_a_window_opens()
+                if host_window is not None:
+                    if had_guard:
+                        host_window._opening_a_screen = previous_guard
+                    else:
+                        del host_window._opening_a_screen
+                    if had_fold_guard:
+                        host_window._opening_a_fold = active_fold
+                    else:
+                        del host_window._opening_a_fold
+            finally:
+                self._opening = False
+
+    def _open_page(self) -> Optional[QWidget]:
+        """Build a first page or put its retained widget back on show."""
+        from . import _breathe_while_a_window_opens
+
         built = self.window
         if built is not None:
             try:
@@ -626,6 +700,7 @@ class FoldOpener:
             except Exception:
                 LOG.exception("Could not open the folded module %r", self.key)
                 return None
+            _breathe_while_a_window_opens(force=True)
         title = folded_module_title(self.key)
         shown = show_as_page(built, self.screen, title)
         if shown is None:
@@ -677,6 +752,15 @@ class PageFold(QObject):
                                                   self.key))
         self.page: Optional[QWidget] = None
         self._watching = False
+        self._deferred_shown = None
+        self._visibility_queued = False
+
+    def _resume_visibility(self) -> None:
+        """Apply the latest switch request after the guarded open returns."""
+        self._visibility_queued = False
+        requested = self._deferred_shown
+        if requested is not None:
+            self.set_shown(requested)
 
     def set_shown(self, on: bool) -> None:
         """Open or close the page.
@@ -688,6 +772,15 @@ class PageFold(QObject):
 
         :param on: the switch's new state.
         """
+        self._deferred_shown = bool(on)
+        if getattr(self.screen.window(), "_opening_a_fold", None) is not None:
+            if not self._visibility_queued:
+                from .. import _after
+
+                self._visibility_queued = True
+                _after(0, self, self._resume_visibility)
+            return
+        self._deferred_shown = None
         if on:
             try:
                 self.page = self.opener.open()
diff --git a/tests/qt/test_fold_opening_keeps_the_event_loop_alive.py b/tests/qt/test_fold_opening_keeps_the_event_loop_alive.py
new file mode 100644
index 0000000000000000000000000000000000000000..bf0a3e421c94e33761b5231394006ba913f81a78
--- /dev/null
+++ b/tests/qt/test_fold_opening_keeps_the_event_loop_alive.py
@@ -0,0 +1,125 @@
+"""A cold fold uses real event-loop turns without reentering its builder."""
+import pytest
+from PySide6.QtCore import QTimer
+from PySide6.QtWidgets import QVBoxLayout, QWidget
+from spacr.qt import screens
+from spacr.qt.screens import map_barcodes as pages
+
+
+def host(qtbot):
+    window = QWidget()
+    window._opening_a_screen = False
+    column = QVBoxLayout(window)
+    column.addWidget(QWidget(window), 1)
+    qtbot.addWidget(window)
+    window.show()
+    return window
+
+
+def test_a_pending_timer_runs_during_open_with_navigation_and_reentry_guarded(qtbot):
+    window = host(qtbot)
+    builds, delivered = [], []
+    def build(_window):
+        builds.append(True)
+        page = QWidget()
+        QTimer.singleShot(0, lambda: delivered.append((window._opening_a_screen,
+                              opener._opening, opener.open())))
+        return page
+    opener = pages.FoldOpener(window, 'illumination', build)
+    opened = opener.open()
+    assert opened is not None and opened.isVisible()
+    assert len(builds) == 1
+    assert delivered == [(True, True, None)]
+    assert window._opening_a_screen is False and opener._opening is False
+    assert screens._a_window_is_opening_a_screen is False
+
+
+@pytest.mark.parametrize('where', ['build', 'show'])
+def test_a_failed_open_restores_the_navigation_and_breathing_guards(qtbot, monkeypatch, where):
+    window = host(qtbot)
+    def failed(*args):
+        raise ValueError('Cannot open this page')
+    opener = pages.FoldOpener(window, 'illumination', failed if where == 'build' else lambda _: QWidget())
+    if where == 'show':
+        monkeypatch.setattr(pages, 'show_as_page', failed)
+        with pytest.raises(ValueError, match='Cannot open'):
+            opener.open()
+    else:
+        assert opener.open() is None
+    assert window._opening_a_screen is False and opener._opening is False
+    assert screens._a_window_is_opening_a_screen is False
+
+
+def test_an_existing_navigation_keeps_its_own_guards(qtbot):
+    window = host(qtbot)
+    window._opening_a_screen = True
+    screens._start_breathing_while_a_window_opens(0)
+    try:
+        opener = pages.FoldOpener(window, 'illumination', lambda _: QWidget())
+        assert opener.open() is not None
+        assert window._opening_a_screen is True
+        assert screens._a_window_is_opening_a_screen is True
+    finally:
+        screens._stop_breathing_while_a_window_opens()
+
+
+def test_a_different_fold_waits_until_the_first_has_finished(qtbot):
+    window = host(qtbot)
+    builds = []
+    def second_build(_window):
+        builds.append(('second', first._opening))
+        return QWidget()
+    second = pages.FoldOpener(window, 'anndata_export', second_build)
+    def first_build(_window):
+        builds.append(('first', True))
+        QTimer.singleShot(0, second.open)
+        return QWidget()
+    first = pages.FoldOpener(window, 'illumination', first_build)
+    assert first.open() is not None
+    qtbot.waitUntil(lambda: second.window is not None)
+    assert builds == [('first', True), ('second', False)]
+    assert not window._opening_a_screen
+    assert not hasattr(window, '_opening_a_fold')
+
+
+def test_a_deferred_fold_does_not_outlive_its_host(qtbot):
+    from shiboken6 import delete
+    window = host(qtbot)
+    window._opening_a_fold = object()
+    builds = []
+    opener = pages.FoldOpener(window, 'illumination', lambda _: builds.append(True))
+    assert opener.open() is None
+    delete(window)
+    qtbot.wait(10)
+    assert builds == []
+
+
+def test_a_queued_page_switch_finishes_its_controller_and_keeps_latest_intent(qtbot):
+    from PySide6.QtWidgets import QCheckBox
+    window = host(qtbot)
+    switch = QCheckBox(window)
+    switch.setChecked(True)
+    second = pages.PageFold(window, switch, 'anndata_export', lambda _: QWidget())
+    def build(_window):
+        QTimer.singleShot(0, lambda: second.set_shown(True))
+        return QWidget()
+    first = pages.FoldOpener(window, 'illumination', build)
+    assert first.open() is not None
+    qtbot.waitUntil(lambda: second.page is not None)
+    assert switch.isChecked() and second.page.isVisible()
+    second.set_shown(False)
+    assert second.page is None
+
+
+def test_a_later_close_cancels_a_page_switch_waiting_for_another_fold(qtbot):
+    from PySide6.QtWidgets import QCheckBox
+    window = host(qtbot)
+    switch = QCheckBox(window)
+    builds = []
+    controller = pages.PageFold(window, switch, 'anndata_export', lambda _: builds.append(True))
+    window._opening_a_fold = object()
+    controller.set_shown(True)
+    controller.set_shown(False)
+    del window._opening_a_fold
+    qtbot.waitUntil(lambda: not controller._visibility_queued)
+    assert builds == [] and controller.page is None
-- 
