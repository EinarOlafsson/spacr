{
  "schema": 1,
  "kind": "native_visual_timing",
  "native_live_video": true,
  "lesson": "23_agreement",
  "fps": 30,
  "total_duration": 250.9,
  "scenes": [
    {
      "scene": 1,
      "speech_start": 0.0,
      "speech_end": 21.333333333333332,
      "scene_end": 21.333333333333332,
      "duration": 21.333333333333332,
      "text": "From Home, open Annotate, then choose Annotator Agreement. Use this tool to compare labels collected in separate annotation passes. The results help you find images that need review.",
      "visual": "02_agreement_fold",
      "longest_narration_duration": 16.905,
      "complete_native_duration": 21.333333333333332,
      "native_live_video": true
    },
    {
      "scene": 2,
      "speech_start": 21.333333333333332,
      "speech_end": 49.03333333333333,
      "scene_end": 49.03333333333333,
      "duration": 27.7,
      "text": "Open the example database. Keep the extracted crop folders beside it so the image previews can load. The DEMO columns contain artificial teaching labels; use your own independent annotation columns when assessing agreement in a study.",
      "visual": "04_demo_database",
      "longest_narration_duration": 23.300000000000004,
      "complete_native_duration": 27.7,
      "native_live_video": true
    },
    {
      "scene": 3,
      "speech_start": 49.03333333333333,
      "speech_end": 67.2,
      "scene_end": 67.2,
      "duration": 18.166666666666668,
      "text": "Select at least two annotation columns from the list. For this example, start with DEMO A and DEMO B. Check the column names so you compare the intended passes.",
      "visual": "05_one_column_not_a_comparison",
      "longest_narration_duration": 13.800000000000004,
      "complete_native_duration": 18.166666666666668,
      "native_live_video": true
    },
    {
      "scene": 4,
      "speech_start": 67.2,
      "speech_end": 97.36666666666667,
      "scene_end": 97.36666666666667,
      "duration": 30.166666666666668,
      "text": "Click Compute agreement. The two selected passes share twelve labelled crops. Three more crops have a label in only one pass, and one has neither label. Pairwise agreement uses the crops labelled by both passes.",
      "visual": "06_two_columns",
      "longest_narration_duration": 25.75,
      "complete_native_duration": 30.166666666666668,
      "native_live_video": true
    },
    {
      "scene": 5,
      "speech_start": 97.36666666666667,
      "speech_end": 125.0,
      "scene_end": 125.0,
      "duration": 27.633333333333333,
      "text": "Read the pairwise results. The passes agree on nine of twelve crops, giving seventy-five percent agreement and a Cohen kappa of zero point five. Read these values alongside the number of shared labels; a small sample gives an uncertain estimate.",
      "visual": "07_pairwise_results",
      "longest_narration_duration": 23.215000000000003,
      "complete_native_duration": 27.633333333333333,
      "native_live_video": true
    },
    {
      "scene": 6,
      "speech_start": 125.0,
      "speech_end": 146.23333333333335,
      "scene_end": 146.23333333333335,
      "duration": 21.233333333333334,
      "text": "Open the confusion matrix. Rows represent DEMO A and columns represent DEMO B. The diagonal contains matching labels: five for class one and four for class two. The off-diagonal cells contain the three disagreements.",
      "visual": "08_confusion_matrix",
      "longest_narration_duration": 16.819999999999993,
      "complete_native_duration": 21.233333333333334,
      "native_live_video": true
    },
    {
      "scene": 7,
      "speech_start": 146.23333333333335,
      "speech_end": 168.23333333333335,
      "scene_end": 168.23333333333335,
      "duration": 22.0,
      "text": "Select a disagreement to view its crop and the labels assigned by each pass. Compare the image with your class definitions. To revise a label after review, return to Annotate.",
      "visual": "09_disagreement_crop_1",
      "longest_narration_duration": 17.575000000000003,
      "complete_native_duration": 22.0,
      "native_live_video": true
    },
    {
      "scene": 8,
      "speech_start": 168.23333333333335,
      "speech_end": 194.33333333333334,
      "scene_end": 194.33333333333334,
      "duration": 26.1,
      "text": "Add DEMO C and click Compute agreement again. The pairwise table now shows all three pairs. Each pair uses its shared labels, while the overall summary uses crops labelled in all three selected passes.",
      "visual": "10_three_columns",
      "longest_narration_duration": 21.690000000000026,
      "complete_native_duration": 26.1,
      "native_live_video": true
    },
    {
      "scene": 9,
      "speech_start": 194.33333333333334,
      "speech_end": 219.8,
      "scene_end": 219.8,
      "duration": 25.466666666666665,
      "text": "Read the overall Fleiss kappa and the unanimous agreement summary. This example gives a Fleiss kappa of about zero point six six three. Review the disagreement list as well: it can include a crop that has labels in only two of the three passes.",
      "visual": "11_three_pass_results",
      "longest_narration_duration": 21.045000000000016,
      "complete_native_duration": 25.466666666666665,
      "native_live_video": true
    },
    {
      "scene": 10,
      "speech_start": 219.8,
      "speech_end": 250.9,
      "scene_end": 250.9,
      "duration": 31.1,
      "text": "To focus on one pair again, select only A and B and click Compute agreement. The results stay in this comparison view; your annotation columns remain in the source database. Continue in Annotate to collect another independent pass or review the identified disagreements.",
      "visual": "12_pairwise_restored",
      "longest_narration_duration": 26.69500000000002,
      "complete_native_duration": 31.1,
      "native_live_video": true
    }
  ],
