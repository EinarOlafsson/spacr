         (spec.keys, spec.label) for spec in everything}
+    assert set(annotate_navigation.items()) <= {
+        (spec.keys, spec.label) for spec in everything
+        if spec.category == "Annotate"}
     for scope in ("Annotate", "Make Masks", "Field browser"):
         assert {"Left", "Right"} <= {
