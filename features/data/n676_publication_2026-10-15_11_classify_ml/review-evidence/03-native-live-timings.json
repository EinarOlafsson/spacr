{
  "schema": 1,
  "kind": "native_visual_timing",
  "native_live_video": true,
  "lesson": "11_classify_ml",
  "fps": 30,
  "total_duration": 268.79999999999995,
  "scenes": [
    {
      "scene": 1,
      "speech_start": 0.0,
      "speech_end": 24.2,
      "scene_end": 24.2,
      "duration": 24.2,
      "text": "From Home, open Classify and choose Tabular Machine Learning. This family uses the object measurements saved by Measure. It produces a fitted model and a score for each object with the required measurements.",
      "visual": "19_setting_classifier_family",
      "longest_narration_duration": 19.794999999999998,
      "complete_native_duration": 24.2,
      "native_live_video": true
    },
    {
      "scene": 2,
      "speech_start": 24.2,
      "speech_end": 45.83333333333333,
      "scene_end": 45.83333333333333,
      "duration": 21.633333333333333,
      "text": "Click Load test data and choose Load. Wait for the measured example to download. For your own data, select the project folder created by Measure, including its measurements database.",
      "visual": "02_data_choice_load",
      "longest_narration_duration": 17.215,
      "complete_native_duration": 21.633333333333333,
      "native_live_video": true
    },
    {
      "scene": 3,
      "speech_start": 45.83333333333333,
      "speech_end": 68.8,
      "scene_end": 68.8,
      "duration": 22.966666666666665,
      "text": "Use Choose source data to confirm the downloaded plate folder. Select the folder containing measurements. This gives the classifier access to the object tables and the metadata used to define classes.",
      "visual": "18_source_folder_choice",
      "longest_narration_duration": 18.570000000000007,
      "complete_native_duration": 22.966666666666665,
      "native_live_video": true
    },
    {
      "scene": 4,
      "speech_start": 68.8,
      "speech_end": 99.26666666666667,
      "scene_end": 99.26666666666667,
      "duration": 30.466666666666665,
      "text": "Choose metadata as the class basis and define two Classes using column I D values c1 and c2. These labels distinguish the two plate columns in the example. To train from your own cell annotations, choose the annotation basis and the label column you created in Annotate.",
      "visual": "19_setting_classes",
      "longest_narration_duration": 26.059999999999995,
      "complete_native_duration": 30.466666666666665,
      "native_live_video": true
    },
    {
      "scene": 5,
      "speech_start": 99.26666666666667,
      "speech_end": 121.7,
      "scene_end": 121.7,
      "duration": 22.433333333333334,
      "text": "Set Channel of interest to one for the example. This controls which channel-specific measurement features enter the model. For your own experiment, select the channel that contains the signal relevant to your classes.",
      "visual": "19_setting_channel_of_interest",
      "longest_narration_duration": 18.00999999999999,
      "complete_native_duration": 22.433333333333334,
      "native_live_video": true
    },
    {
      "scene": 6,
      "speech_start": 121.7,
      "speech_end": 153.7,
      "scene_end": 153.7,
      "duration": 32.0,
      "text": "Choose Random Forest, sixteen estimators and two worker jobs. Estimators controls the number of trees. More trees increase fitting work. Leave feature pruning and cross-validation off for this first pass; you can compare those choices after you have a working baseline.",
      "visual": "19_setting_n_estimators",
      "longest_narration_duration": 27.595,
      "complete_native_duration": 32.0,
      "native_live_video": true
    },
    {
      "scene": 7,
      "speech_start": 153.7,
      "speech_end": 180.86666666666665,
      "scene_end": 180.86666666666665,
      "duration": 27.166666666666668,
      "text": "Set Test size to one tenth and keep grouping by well. spaCR holds out complete wells, so the final fraction of objects can differ from the requested fraction. Read the resolved split in the console and make sure it suits your experiment.",
      "visual": "19_setting_test_size",
      "longest_narration_duration": 22.770000000000024,
      "complete_native_duration": 27.166666666666668,
      "native_live_video": true
    },
    {
      "scene": 8,
      "speech_start": 180.86666666666665,
      "speech_end": 205.23333333333332,
      "scene_end": 205.23333333333332,
      "duration": 24.366666666666667,
      "text": "Enable Plot, clear the search and press Run. The console shows feature filtering, the training and test split, model fitting and the saved output paths. Wait for the run to finish before comparing its scores.",
      "visual": "19_setting_plot",
      "longest_narration_duration": 19.985000000000014,
      "complete_native_duration": 24.366666666666667,
      "native_live_video": true
    },
    {
      "scene": 9,
      "speech_start": 205.23333333333332,
      "speech_end": 236.29999999999998,
      "scene_end": 236.29999999999998,
      "duration": 31.066666666666666,
      "text": "Find the results under results, random_forest, channel underscore one. The database stores the predicted class in predictions and the class-one probability in ml_pred. Objects missing required measurements can remain unscored; inspect missing values when exporting a summary.",
      "visual": "23_batch_finished",
      "longest_narration_duration": 26.660000000000025,
      "complete_native_duration": 31.066666666666666,
      "native_live_video": true
    },
    {
      "scene": 10,
      "speech_start": 236.29999999999998,
      "speech_end": 268.79999999999995,
      "scene_end": 268.79999999999995,
      "duration": 32.5,
      "text": "Browse the feature-importance figures and plate heatmap. With Predictions and mean grouping, a well value is the average of its binary predicted classes. Use the saved object scores for detailed review, and compare held-out performance before applying the classifier to another experiment.",
      "visual": "25_ml_figure_02",
      "longest_narration_duration": 28.07000000000002,
      "complete_native_duration": 32.5,
      "native_live_video": true
    }
  ],
