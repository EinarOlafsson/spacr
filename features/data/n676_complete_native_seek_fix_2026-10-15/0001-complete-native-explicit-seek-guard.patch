From 8ab0b4f421baf9e6318c9f9f0d08ccd73241113b Mon Sep 17 00:00:00 2001
From: Einar Olafsson <einar.olafsson@gmail.com>
Date: Thu, 15 Oct 2026 20:25:04 -0400
Subject: [PATCH] Preserve explicit narration seeks while native video loads

---
 tools/tutorials/authoring/web/app_v2.js             |  3 +--
 .../tests/test_player_preserve_visual_intervals.py  | 13 ++++++++-----
 2 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/tools/tutorials/authoring/web/app_v2.js b/tools/tutorials/authoring/web/app_v2.js
index 46c963a80..88adc08f2 100644
--- a/tools/tutorials/authoring/web/app_v2.js
+++ b/tools/tutorials/authoring/web/app_v2.js
@@ -1439,8 +1439,7 @@ function syncCompleteNativeNarration(seek = false) {
   if (narrationLoadPending || !completeNativePlayback() || !narrationAudioAvailable ||
       elements.voice.value === "silent" || !elements.video.duration ||
       !elements.audio.duration || !audioTimings) return;
-  if (visualTimings?.preserve_visual_intervals === true &&
-      (videoClockCorrectionPending || elements.video.seeking)) {
+  if (videoClockCorrectionPending || elements.video.seeking) {
     if (!elements.audio.paused) elements.audio.pause();
     return;
   }
diff --git a/tools/tutorials/tests/test_player_preserve_visual_intervals.py b/tools/tutorials/tests/test_player_preserve_visual_intervals.py
index fe4ee6f0d..f6b4f00f6 100644
--- a/tools/tutorials/tests/test_player_preserve_visual_intervals.py
+++ b/tools/tutorials/tests/test_player_preserve_visual_intervals.py
@@ -1,5 +1,6 @@
 """Retained visual intervals stay intact without asserting full raw-clip coverage."""
 import json
+import pytest
 
 from test_player_complete_native_clips import complete_fixture, open_player
 from test_player_holds_narration import served
@@ -102,15 +103,17 @@ def test_preserved_static_chapter_seek_and_caption_cues_use_elapsed_speech(serve
             browser.close()
 
 
-def test_cold_paused_sentence_seeks_never_rewind_the_requested_audio_offset(served, tmp_path):
+@pytest.mark.parametrize('visual_mode', ['preserved', 'complete_native'])
+def test_cold_paused_sentence_seeks_never_rewind_the_requested_audio_offset(served, tmp_path, visual_mode):
     from playwright.sync_api import sync_playwright
     url = complete_fixture(served, tmp_path)
     visual_path = tmp_path / 'complete-native-visual.json'
     visual = json.loads(visual_path.read_text())
-    del visual['complete_native_clips']
-    visual['preserve_visual_intervals'] = True
-    visual['scenes'][0]['native_live_video'] = False
-    visual['scenes'][-1]['native_live_video'] = False
+    if visual_mode == 'preserved':
+        del visual['complete_native_clips']
+        visual['preserve_visual_intervals'] = True
+        visual['scenes'][0]['native_live_video'] = False
+        visual['scenes'][-1]['native_live_video'] = False
     visual_path.write_text(json.dumps(visual))
     catalog_path = tmp_path / 'complete-native-catalog.js'
     script = catalog_path.read_text()
