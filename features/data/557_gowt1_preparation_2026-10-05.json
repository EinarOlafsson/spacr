    "source": "import hashlib\nimport json\nfrom pathlib import Path\n\nimport numpy as np\nimport tifffile\n\nscratch = Path('/media/carruthers/mnt3/codex/scratch/docs-completion-20261005')\nroot = scratch / '557-gowt1'\ndataset = root / 'Fluo-N2DH-GOWT1'\ntarget = root / 'prepared-r1'\nassert not target.exists()\ntarget.mkdir()\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\ncompleteness = json.loads((root / 'gold-completeness.json').read_text())\ntests = [row for row in completeness['rows']\n         if row['sequence'] == '01' and row['all_tracking_objects_have_distinct_gold_masks']]\nassert [row['frame'] for row in tests] == [21, 31, 33, 39]\ntest_cases = []\nfor row in tests:\n    paths = {kind: Path(row[kind]) for kind in ('image', 'segmentation', 'tracking')}\n    assert all(digest(path) == row[kind + '_sha256'] for kind, path in paths.items())\n    image, truth, markers = [tifffile.imread(paths[kind]) for kind in ('image', 'segmentation', 'tracking')]\n    assert image.shape == truth.shape == markers.shape == (1024, 1024)\n    assert np.isfinite(image).all()\n    marker_ids = np.unique(markers)[1:]\n    truth_ids = np.unique(truth)[1:]\n    assert len(marker_ids) == len(truth_ids) == 24\n    matches = []\n    for label in marker_ids:\n        hit = np.unique(truth[markers == label])\n        hit = hit[hit != 0]\n        assert len(hit) == 1\n        matches.append(int(hit[0]))\n    assert len(set(matches)) == len(matches)\n    assert set(matches) == set(map(int, truth_ids))\n    inside = np.unique(truth[50:-50, 50:-50])\n    inside = inside[inside != 0]\n    assert set(inside) == set(truth_ids)\n    exported = target / f'01-t{row[\"frame\"]:03d}.npy'\n    np.save(exported, image, allow_pickle=False)\n    assert np.array_equal(np.load(exported, allow_pickle=False), image)\n    test_cases.append({**row, 'exact_pixel_export': str(exported),\n                       'export_sha256': digest(exported), 'dtype': str(image.dtype),\n                       'gold_marker_to_mask_bijection_verified': True,\n                       'all_24_gold_objects_intersect_field_of_interest': True,\n                       'source_paths': {kind: str(path) for kind, path in paths.items()}})\n\navailable = sorted((dataset / '02').glob('t*.tif'))\nassert len(available) >= 20\nindices = np.rint(np.linspace(0, len(available) - 1, 20)).astype(int)\nassert len(set(indices)) == 20\ntraining = []\nfor index in indices:\n    path = available[index]\n    image = tifffile.imread(path)\n    assert image.shape == (1024, 1024) and np.isfinite(image).all()\n    exported = target / ('02-' + path.stem + '.npy')\n    np.save(exported, image, allow_pickle=False)\n    assert np.array_equal(np.load(exported, allow_pickle=False), image)\n    training.append({'image': str(path), 'image_sha256': digest(path),\n                     'exact_pixel_export': str(exported), 'export_sha256': digest(exported),\n                     'dtype': str(image.dtype), 'shape': list(image.shape)})\nassert not ({row['image'] for row in training} & {row['image'] for row in test_cases})\nassert all(digest(Path(row[kind])) == row[kind + '_sha256']\n           for row in tests for kind in ('image', 'segmentation', 'tracking'))\nassert all(digest(Path(row['image'])) == row['image_sha256'] for row in training)\n\nplan = {\n    'schema': 1, 'accepted_preparation': True,\n    'scope': 'An additional real fluorescent-nucleus dataset for source-frozen denoising validation; preparation only, no training or improvement claim.',\n    'dataset': 'CTC Fluo-N2DH-GOWT1, GFP-GOWT1 mouse stem cells',\n    'dataset_source': 'https://celltrackingchallenge.net/2d-datasets/',\n    'annotation_procedure': 'https://public.celltrackingchallenge.net/documents/Annotation%20procedure.pdf',\n    'field_of_interest_border_pixels': 50,\n    'scoring_policy': 'For each predicted mask, retain complete object pixels if any pixel intersects [50:-50,50:-50]; exclude only wholly exterior predicted objects. Compare full retained masks to all 24 gold masks. Object IoU/Hungarian F1 is our paired benchmark, not an official CTC SEG/DET/TRA score.',\n    'gold_completeness_policy': 'Every gold tracking marker must overlap exactly one distinct segmentation mask, with a complete bijection. Partial frames and silver masks are excluded from F1. Marker position alone never justifies dropping a gold object.',\n    'training': training, 'evaluation': test_cases,\n    'training_selection': 'Twenty evenly spaced raw frames from sequence 02, independent of sequence-01 evaluation labels. No sequence-01 image is used for denoiser training.',\n    'predeclared_n2v': {'epochs': 20, 'seed': 0, 'checkpoint_selection': 'final epoch; no selection using evaluation F1'},\n    'predeclared_comparison': 'Raw, normal NLM enhancement, normal Cellpose-3 nucleus restoration and normal CAREamics N2V2; identical fixed segmentation parameters across arms. Threshold tuning on the four evaluation frames is prohibited.',\n    'limitations': ['Only one held-out sequence and four nearby timepoints; these are not four independent biological replicates.',\n                   'The dataset page does not establish calibrated low-light acquisition or photon counts; no low-light ground-truth claim is made.',\n                   'Gains or losses on this dataset do not establish a universal denoising benefit.'],\n    'original_pixels_and_gold_labels_unchanged': True,\n    'gpu_training_started': False,\n}\n(target / 'plan.json').write_text(json.dumps(plan, indent=2) + '\\n')\nprint('Prepared 20 independent-sequence raw training frames and four complete 24-object gold evaluation frames; FOI=50.')\n"
