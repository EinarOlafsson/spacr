# spaCR workflow exported from run 2026-10-02_043706_e46ad6a6__measure.
#
# One job per plate: every settings/<plate>.json is one `spacr-run measure`.
# Add a plate by copying a settings file and changing its "src".
#
#   snakemake --cores 4                          # this machine
#   snakemake --cores 4 --use-apptainer          # inside ghcr.io/einarolafsson/spacr:1.5.1.1-cpu
#   snakemake --executor slurm --jobs 20 --use-apptainer   # a cluster
#
# Inside a container the data folders must be visible at the same paths,
# e.g. --apptainer-args "--bind /data". config.yaml holds the image and the
# spacr-run command.

configfile: "config.yaml"

PLATES = glob_wildcards("settings/{plate}.json").plate


rule all:
    input:
        expand("done/{plate}.ok", plate=PLATES)


rule spacr_measure:
    input:
        "settings/{plate}.json"
    output:
        touch("done/{plate}.ok")
    log:
        "logs/{plate}.log"
    container:
        config["image"]
    params:
        spacr_run=config["spacr_run"]
    threads: config.get("threads", 1)
    shell:
        "{params.spacr_run} measure --settings {input} > {log} 2>&1"
