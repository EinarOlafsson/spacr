{
  "schema": 1,
  "kind": "native_visual_timing",
  "native_live_video": true,
  "lesson": "05_home",
  "fps": 30,
  "total_duration": 785.6999999999999,
  "scenes": [
    {
      "scene": 1,
      "speech_start": 0.0,
      "speech_end": 32.333333333333336,
      "scene_end": 32.333333333333336,
      "duration": 32.333333333333336,
      "text": "Home is the starting point. Its overview groups modules under Core, Data, Tools and Organism. The category tabs narrow the view. Every tile opens its named module. The sidebar provides the same routes, and Home returns to the overview.",
      "visual": "00_home",
      "longest_narration_duration": 25.325,
      "complete_native_duration": 32.333333333333336,
      "native_live_video": true
    },
    {
      "scene": 2,
      "speech_start": 32.333333333333336,
      "speech_end": 49.13333333333334,
      "scene_end": 49.13333333333334,
      "duration": 16.8,
      "text": "Mask generates object masks from microscopy images. We will open it briefly later to learn the controls shared by analysis modules.",
      "visual": "home_module_mask",
      "longest_narration_duration": 12.370000000000001,
      "complete_native_duration": 16.8,
      "native_live_video": true
    },
    {
      "scene": 3,
      "speech_start": 49.13333333333334,
      "speech_end": 66.23333333333335,
      "scene_end": 66.23333333333335,
      "duration": 17.1,
      "text": "Measure combines images and masks to extract object measurements and crops. Its measurement tables connect images to later analyses.",
      "visual": "home_module_measure",
      "longest_narration_duration": 12.680000000000007,
      "complete_native_duration": 17.1,
      "native_live_video": true
    },
    {
      "scene": 4,
      "speech_start": 66.23333333333335,
      "speech_end": 78.53333333333335,
      "scene_end": 78.53333333333335,
      "duration": 12.3,
      "text": "Annotate lets you inspect object crops and record reviewed labels for examples.",
      "visual": "home_module_annotate",
      "longest_narration_duration": 7.885000000000005,
      "complete_native_duration": 12.3,
      "native_live_video": true
    },
    {
      "scene": 5,
      "speech_start": 78.53333333333335,
      "speech_end": 90.60000000000001,
      "scene_end": 90.60000000000001,
      "duration": 12.066666666666666,
      "text": "Map Barcodes reads sequencing data to count and identify guides or barcodes.",
      "visual": "home_module_map_barcodes",
      "longest_narration_duration": 7.634999999999991,
      "complete_native_duration": 12.066666666666666,
      "native_live_video": true
    },
    {
      "scene": 6,
      "speech_start": 90.60000000000001,
      "speech_end": 104.36666666666667,
      "scene_end": 104.36666666666667,
      "duration": 13.766666666666667,
      "text": "Regression relates phenotype scores to sequencing guide counts, preserving the experimental grouping.",
      "visual": "home_module_regression",
      "longest_narration_duration": 9.36,
      "complete_native_duration": 13.766666666666667,
      "native_live_video": true
    },
    {
      "scene": 7,
      "speech_start": 104.36666666666667,
      "speech_end": 117.46666666666667,
      "scene_end": 117.46666666666667,
      "duration": 13.1,
      "text": "Import prepares incoming microscopy files and metadata for the project structure.",
      "visual": "home_module_foreign",
      "longest_narration_duration": 8.685000000000002,
      "complete_native_duration": 13.1,
      "native_live_video": true
    },
    {
      "scene": 8,
      "speech_start": 117.46666666666667,
      "speech_end": 129.33333333333334,
      "scene_end": 129.33333333333334,
      "duration": 11.866666666666667,
      "text": "Run Compare brings saved run results together so you can inspect differences.",
      "visual": "home_module_run_compare",
      "longest_narration_duration": 7.469999999999999,
      "complete_native_duration": 11.866666666666667,
      "native_live_video": true
    },
    {
      "scene": 9,
      "speech_start": 129.33333333333334,
      "speech_end": 143.13333333333335,
      "scene_end": 143.13333333333335,
      "duration": 13.8,
      "text": "Power / Design explores sample-size and power assumptions when planning comparisons.",
      "visual": "home_module_power",
      "longest_narration_duration": 9.414999999999992,
      "complete_native_duration": 13.8,
      "native_live_video": true
    },
    {
      "scene": 10,
      "speech_start": 143.13333333333335,
      "speech_end": 156.0666666666667,
      "scene_end": 156.0666666666667,
      "duration": 12.933333333333334,
      "text": "Make Masks lets you draw and review masks by hand, or prepare image-mask pairs.",
      "visual": "home_module_make_masks",
      "longest_narration_duration": 8.524999999999991,
      "complete_native_duration": 12.933333333333334,
      "native_live_video": true
    },
    {
      "scene": 11,
      "speech_start": 156.0666666666667,
      "speech_end": 168.16666666666669,
      "scene_end": 168.16666666666669,
      "duration": 12.1,
      "text": "Align & Stitch joins compatible image tiles and records their geometry.",
      "visual": "home_module_align",
      "longest_narration_duration": 7.699999999999989,
      "complete_native_duration": 12.1,
      "native_live_video": true
    },
    {
      "scene": 12,
      "speech_start": 168.16666666666669,
      "speech_end": 183.16666666666669,
      "scene_end": 183.16666666666669,
      "duration": 15.0,
      "text": "Image UMAP projects object features so you can explore similar objects and inspect representative crops.",
      "visual": "home_module_umap",
      "longest_narration_duration": 10.579999999999998,
      "complete_native_duration": 15.0,
      "native_live_video": true
    },
    {
      "scene": 13,
      "speech_start": 183.16666666666669,
      "speech_end": 196.0666666666667,
      "scene_end": 196.0666666666667,
      "duration": 12.9,
      "text": "Graph Builder creates plots from measurement tables with configurable columns and grouping.",
      "visual": "home_module_graph_builder",
      "longest_narration_duration": 8.490000000000023,
      "complete_native_duration": 12.9,
      "native_live_video": true
    },
    {
      "scene": 14,
      "speech_start": 196.0666666666667,
      "speech_end": 224.53333333333336,
      "scene_end": 224.53333333333336,
      "duration": 28.466666666666665,
      "text": "Open Mask as a generic example of an analysis module. Here we are learning the screen layout, rather than completing a segmentation workflow. Settings sit on the left, the console and progress panels on the right, and actions along the bottom. Live opens the module’s preview when input data is available.",
      "visual": "06_mask_host",
      "longest_narration_duration": 24.045000000000016,
      "complete_native_duration": 28.466666666666665,
      "native_live_video": true
    },
    {
      "scene": 15,
      "speech_start": 224.53333333333336,
      "speech_end": 248.3,
      "scene_end": 248.3,
      "duration": 23.766666666666666,
      "text": "Settings are grouped into sections. Expand a section to see its controls. Choose your own input folder or use Load test data when a supplied example is available. Labels and help explain what each setting expects.",
      "visual": "06b_mask_settings",
      "longest_narration_duration": 19.345,
      "complete_native_duration": 23.766666666666666,
      "native_live_video": true
    },
    {
      "scene": 16,
      "speech_start": 248.3,
      "speech_end": 277.56666666666666,
      "scene_end": 277.56666666666666,
      "duration": 29.266666666666666,
      "text": "Import settings brings a saved configuration into this form. Run starts the chosen work and Stop asks a running job to stop. The console reports progress and messages. Check the module-specific tutorial before starting an analysis.",
      "visual": "06c_mask_actions",
      "longest_narration_duration": 24.840000000000003,
      "complete_native_duration": 29.266666666666666,
      "native_live_video": true
    },
    {
      "scene": 17,
      "speech_start": 277.56666666666666,
      "speech_end": 298.3333333333333,
      "scene_end": 298.3333333333333,
      "duration": 20.766666666666666,
      "text": "Drag the divider to give the settings or preview more space. Control plus the mouse wheel changes the text size in a column. These layout controls help you read the settings without changing the analysis itself.",
      "visual": "14_resize_panels",
      "longest_narration_duration": 16.390000000000015,
      "complete_native_duration": 20.766666666666666,
      "native_live_video": true
    },
    {
      "scene": 18,
      "speech_start": 298.3333333333333,
      "speech_end": 333.93333333333334,
      "scene_end": 333.93333333333334,
      "duration": 35.6,
      "text": "Back on Home, the column on the right keeps track of your work. Recent runs lists what you ran, Totals counts runs, masks and measurements, and System shows the load on your computer. While a run is going or waiting, it appears here too. The Text size slider under the lowest panel makes this column's text larger or smaller.",
      "visual": "10_home_column",
      "longest_narration_duration": 31.170000000000016,
      "complete_native_duration": 35.6,
      "native_live_video": true
    },
    {
      "scene": 19,
      "speech_start": 333.93333333333334,
      "speech_end": 361.5,
      "scene_end": 361.5,
      "duration": 27.566666666666666,
      "text": "The arrow handle on the column's left edge works like the module handles. Drag it to make the column wider or narrower, or click it to fold the column away so the tiles get the whole width. Click the arrow again to bring the column back.",
      "visual": "11_column_folded",
      "longest_narration_duration": 23.189999999999998,
      "complete_native_duration": 27.566666666666666,
      "native_live_video": true
    },
    {
      "scene": 20,
      "speech_start": 361.5,
      "speech_end": 391.5,
      "scene_end": 391.5,
      "duration": 30.0,
      "text": "Type a module, setting or function name into the search field beside Help. Here, searching for Performance finds the matching Preferences page. Click a result to open its destination. API results open the documentation for the selected function.",
      "visual": "08_help_search",
      "longest_narration_duration": 25.625,
      "complete_native_duration": 30.0,
      "native_live_video": true
    },
    {
      "scene": 21,
      "speech_start": 391.5,
      "speech_end": 418.1666666666667,
      "scene_end": 418.1666666666667,
      "duration": 26.666666666666668,
      "text": "Press Control-K anywhere to open the command palette. Start typing a name, such as Measure, and the list narrows as you type. Press Enter to jump to the highlighted module, recent run or menu action without reaching for the mouse.",
      "visual": "12_command_palette",
      "longest_narration_duration": 22.274999999999977,
      "complete_native_duration": 26.666666666666668,
      "native_live_video": true
    },
    {
      "scene": 22,
      "speech_start": 418.1666666666667,
      "speech_end": 451.40000000000003,
      "scene_end": 451.40000000000003,
      "duration": 33.233333333333334,
      "text": "In Preferences, choose a Performance profile for your computer. Laptop uses fewer resources; the higher profiles allow more caching and background work. Start with a modest profile if memory is limited. Your analysis settings stay under your control in each module.",
      "visual": "09_performance",
      "longest_narration_duration": 28.805000000000007,
      "complete_native_duration": 33.233333333333334,
      "native_live_video": true
    },
    {
      "scene": 23,
      "speech_start": 451.40000000000003,
      "speech_end": 481.6333333333334,
      "scene_end": 481.6333333333334,
      "duration": 30.233333333333334,
      "text": "The General tab of Preferences sets the interface language, the font and GUI scale, whether the app dock stays open, and a palette for plots that suits colour vision deficiency. The Figures tab chooses the format and resolution of saved figures, and Appearance controls when tooltips appear.",
      "visual": "13_preferences_general",
      "longest_narration_duration": 25.82499999999999,
      "complete_native_duration": 30.233333333333334,
      "native_live_video": true
    },
    {
      "scene": 24,
      "speech_start": 481.6333333333334,
      "speech_end": 520.9666666666667,
      "scene_end": 520.9666666666667,
      "duration": 39.333333333333336,
      "text": "Appearance decides how help appears as you work. Tooltip delay sets how long the pointer rests before a floating tip appears: two seconds by default, or zero for immediate tips. Show tooltips controls those floating tips. The dedicated help areas on Home and in Preferences show their text immediately. Theme and Animation fold open below to set the window's appearance.",
      "visual": "13b_preferences_appearance",
      "longest_narration_duration": 34.964999999999975,
      "complete_native_duration": 39.333333333333336,
      "native_live_video": true
    },
    {
      "scene": 25,
      "speech_start": 520.9666666666667,
      "speech_end": 557.4,
      "scene_end": 557.4,
      "duration": 36.43333333333333,
      "text": "Theme and Animation are folded sections of Appearance. Click Theme to open it: it sets the interface theme and page opacity, whether fields fade towards the right, and the window rim, with its length, how closely it follows the pointer, its alignment, mode and cycle. The Theme list also offers High contrast, which strengthens the contrast between text, controls and background.",
      "visual": "13c_appearance_theme",
      "longest_narration_duration": 32.01999999999998,
      "complete_native_duration": 36.43333333333333,
      "native_live_video": true
    },
    {
      "scene": 26,
      "speech_start": 557.4,
      "speech_end": 648.7333333333333,
      "scene_end": 648.7333333333333,
      "duration": 91.33333333333333,
      "text": "Click Animation to choose the main backdrop and its palette. Animation colours sets the primary and accent colours for Custom colours; Animation background chooses an independent background, and Theme colour restores the page theme. Detail controls rendering resolution. Speed, Size and Density change motion and population. Mouse gravity radius sets mouse influence; zero disables it. Dot blinking controls white flashes. Field ripples sets the strength of ripples from clicks, opening or closing containers, popups and window snapping, independently of mouse gravity; zero turns ripples off, including the automatic popup waves. Click ripples decides whether a click on the background sends a ripple. Popup wave frequency sets how many waves per minute spread from an open popup window into spaCR field. Settings animation speed, Settings animation size, Settings animation detail and Settings animation density change only the Settings backdrop. Settings backdrop darkness controls the form’s readability.",
      "visual": "13d_appearance_animation",
      "longest_narration_duration": 72.46999999999997,
      "complete_native_duration": 91.33333333333333,
      "native_live_video": true
    },
    {
      "scene": 27,
      "speech_start": 648.7333333333333,
      "speech_end": 681.5333333333333,
      "scene_end": 681.5333333333333,
      "duration": 32.8,
      "text": "Click Apply to preview your changes while Preferences stays open. A separate question asks whether to Keep or Revert the applied settings. Revert restores the previous settings; your edited controls remain available so you can adjust them or apply again.",
      "visual": "13h_preferences_apply",
      "longest_narration_duration": 27.85499999999996,
      "complete_native_duration": 32.8,
      "native_live_video": true
    },
    {
      "scene": 28,
      "speech_start": 681.5333333333333,
      "speech_end": 702.9,
      "scene_end": 702.9,
      "duration": 21.366666666666667,
      "text": "Keep accepts the applied settings and leaves Preferences open. Continue adjusting another tab, or click Save when you are ready to keep the current values and close the window.",
      "visual": "13i_preferences_kept",
      "longest_narration_duration": 16.93999999999994,
      "complete_native_duration": 21.366666666666667,
      "native_live_video": true
    },
    {
      "scene": 29,
      "speech_start": 702.9,
      "speech_end": 734.1999999999999,
      "scene_end": 734.1999999999999,
      "duration": 31.3,
      "text": "On the Modules tab, Session decides whether spaCR reopens the last module, settings and folder when it starts; this recording starts fresh. Update channel chooses stable releases or nightly builds, and Proxy and Certificate bundle let downloads work behind an institutional proxy.",
      "visual": "13e_session_updates",
      "longest_narration_duration": 26.875,
      "complete_native_duration": 31.3,
      "native_live_video": true
    },
    {
      "scene": 30,
      "speech_start": 734.1999999999999,
      "speech_end": 761.0999999999999,
      "scene_end": 761.0999999999999,
      "duration": 26.9,
      "text": "The Storage tab sets how long spaCR keeps its daily logs, run logs and run folders, and a size cap for each. Below them, the cache list shows where models and downloads are stored, with Clear and Move for each cache.",
      "visual": "13f_storage",
      "longest_narration_duration": 22.480000000000018,
      "complete_native_duration": 26.9,
      "native_live_video": true
    },
    {
      "scene": 31,
      "speech_start": 761.0999999999999,
      "speech_end": 785.6999999999999,
      "scene_end": 785.6999999999999,
      "duration": 24.6,
      "text": "Prune now never deletes without asking. With a short example limit for run folders, it lists what it would delete in each folder and waits for an answer. Click Cancel and nothing is removed.",
      "visual": "13g_storage_prune",
      "longest_narration_duration": 20.184999999999945,
      "complete_native_duration": 24.6,
      "native_live_video": true
    }
  ],
