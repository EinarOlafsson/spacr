msgstr ""

msgid "``build-essential libx11-dev``"
msgstr "``build-essential libx11-dev``"

msgid "DNF or Zypper"
msgstr ""

msgid "``gcc-c++ libX11-devel``"
msgstr "``gcc-c++ libX11-devel``"

