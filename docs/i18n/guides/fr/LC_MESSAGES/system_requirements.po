msgid "Storage"
msgstr "Stockage"

msgid "SSD; reserve 30 GB for the environment, caches and initial models, plus project space"
msgstr "SSD ; réservez 30 Go pour l’environnement, les caches et les premiers modèles, plus l’espace des projets"

