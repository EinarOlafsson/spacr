msgstr "Medio: placas de microscopía rutinarias"

msgid "High: large screens and model training"
msgstr "Alto: cribados grandes y entrenamiento de modelos"

msgid "CPU"
msgstr "CPU"

msgid "4–8 modern cores; about 2.5–3.5 GHz sustained on x86"
msgstr "4–8 núcleos modernos; unos 2,5–3,5 GHz sostenidos en x86"

msgid "8–16 cores; about 3–4 GHz sustained on x86"
msgstr "8–16 núcleos; unos 3–4 GHz sostenidos en x86"

msgid "16–32 cores; about 3–4 GHz sustained on x86"
msgstr "16–32 núcleos; unos 3–4 GHz sostenidos en x86"

msgid "RAM"
msgstr "RAM"

msgid "16 GB; process a few fields at a time"
msgstr "16 GB; procesar pocos campos a la vez"

msgid "32–64 GB"
msgstr "32–64 GB"

msgid "128 GB or more"
msgstr "128 GB o más"

msgid "GPU memory"
msgstr "Memoria GPU"

msgid "CPU operation, or a compatible GPU with 8 GB for modest tiled inference"
msgstr "Funcionamiento en CPU, o una GPU compatible con 8 GB para una inferencia moderada por mosaicos"

msgid "Compatible GPU with 12–16 GB dedicated VRAM; Apple silicon with 32–64 GB unified memory"
msgstr "GPU compatible con 12–16 GB de VRAM dedicada; Apple Silicon con 32–64 GB de memoria unificada"

