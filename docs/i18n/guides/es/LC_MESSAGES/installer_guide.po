# AI technical review (Codex), no native-speaker signoff.
msgid "Package manager"
msgstr "Gestor de paquetes"

# AI technical review (Codex), no native-speaker signoff.
msgid "Build packages"
msgstr "Paquetes de compilación"

# AI technical review (Codex), no native-speaker signoff.
msgid "APT"
msgstr "APT"

