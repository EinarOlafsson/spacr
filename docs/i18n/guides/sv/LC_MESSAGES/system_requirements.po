msgstr "RAM"

msgid "16 GB; process a few fields at a time"
msgstr "16 GB; bearbeta några fält åt gången"

msgid "32–64 GB"
msgstr "32–64 GB"

msgid "128 GB or more"
msgstr "128 GB eller mer"

msgid "GPU memory"
msgstr "Minne GPU"

msgid "CPU operation, or a compatible GPU with 8 GB for modest tiled inference"
msgstr "CPU-drift, eller en kompatibel GPU med 8 GB för måttlig inferens i plattor"

msgid "Compatible GPU with 12–16 GB dedicated VRAM; Apple silicon with 32–64 GB unified memory"
msgstr "Kompatibel GPU med 12–16 GB dedikerat VRAM; Apple silicon med 32–64 GB enhetligt minne"

