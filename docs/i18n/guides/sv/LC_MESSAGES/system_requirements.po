msgstr "Medel: rutinmässiga mikroskopiplattor"

msgid "High: large screens and model training"
msgstr "Hög: stora screener och modellträning"

msgid "CPU"
msgstr "CPU"

msgid "4–8 modern cores; about 2.5–3.5 GHz sustained on x86"
msgstr "4–8 moderna kärnor; cirka 2,5–3,5 GHz uthållig klockfrekvens på x86"

msgid "8–16 cores; about 3–4 GHz sustained on x86"
msgstr "8–16 kärnor; cirka 3–4 GHz uthållig klockfrekvens på x86"

msgid "16–32 cores; about 3–4 GHz sustained on x86"
msgstr "16–32 kärnor; cirka 3–4 GHz uthållig klockfrekvens på x86"

