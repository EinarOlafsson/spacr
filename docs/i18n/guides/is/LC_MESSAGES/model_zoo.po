msgstr "SHA-256 ``f2a1e1110f09b2a1d5ef5545adaba7c57f1158669d0bfc50d8fabe9f86da30c7``."

msgid "Toxoplasma from Cell Mask (cross-channel)"
msgstr "Toxoplasma út frá frumugrímu (milli rása)"

msgid "**Trained on.** cross-channel: given the host cell image, predicts where the Toxoplasma parasitophorous vacuoles are, with no parasite stain. 100 epochs, base cpsam_v2, AdamW lr 1e-5, targets are PV-regenerated masks"
msgstr "**Þjálfað á.** milli rása: út frá mynd af hýsilfrumu spáir það fyrir um hvar sníkjubólur Toxoplasma eru, án litunar á sníkjudýrinu. 100 lotur, grunnur cpsam_v2, AdamW lr 1e-5, mörk eru PV-endursköpuð grímur"

msgid "**Measured.** F1 0.606 against 0.021 for stock cpsam_v2 on 463 well-grouped held-out fields, at IoU 0.5"
msgstr "**Mælt.** F1 0,606 á móti 0,021 fyrir staðlað cpsam_v2 á 463 geymdum sjónsviðum hópuðum eftir brunni, við IoU 0,5"

msgid "F1 0.606, AJI 0.494, Dice 0.610 at IoU 0.5 against stock cpsam_v2's 0.021/0.008/0.020 -- stock cannot do this task at all"
msgstr "F1 0,606, AJI 0,494, Dice 0,610 við IoU 0,5 á móti 0,021/0,008/0,020 hjá stöðluðu cpsam_v2 -- staðlaða líkanið ræður alls ekki við þetta verkefni"

msgid "per host: HeLa 0.711, HFF 0.557, THP1 0.465; THP1 is the weak case"
msgstr "eftir hýsli: HeLa 0,711, HFF 0,557, THP1 0,465; THP1 er veika tilvikið"

msgid "the held-out split selects the checkpoint, so it is validation data rather than an independent test set"
msgstr "geymda skiptingin velur vistunarpunktinn, svo hún er sannprófunargögn frekar en óháð prófunarsafn"

msgid "accuracy falls above IoU 0.8 -- suited to counting, occupancy and area rather than precise morphometry"
msgstr "nákvæmni fellur yfir IoU 0,8 -- hentar til talningar, mats á nýtingu og flatarmáls frekar en nákvæmrar formmælingar"

msgid "Published as `einarolafsson/toxoplasma-from-cellmask-cpsam <https://huggingface.co/einarolafsson/toxoplasma-from-cellmask-cpsam>`_, as ``toxoplasma_from_cellmask_pv``."
msgstr "Birt sem `einarolafsson/toxoplasma-from-cellmask-cpsam <https://huggingface.co/einarolafsson/toxoplasma-from-cellmask-cpsam>`_, sem ``toxoplasma_from_cellmask_pv``."

