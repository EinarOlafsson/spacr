  "source_sha256": {
    "tools/tutorials/lessons/05_home.json": "6afb98b447553e15b869f94b63cd3eccda408d2d9d787e24609da80c1a39bd17",
    "tools/tutorials/capture_home_lesson.py": "49cde9475e0960a556c63c8859fc7f0ff58b966f24562ab476eb2ccb5c047696",
    "tools/tutorials/capture_refresh.py": "5a060684c88515c1b6102e9d17420574343879089ea76cee0021de015711eada",
