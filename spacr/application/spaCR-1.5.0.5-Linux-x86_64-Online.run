' "$@" ;;
    is:installing_linux_deps) printf 'Set upp nauðsynleg smásöfn fyrir Linux-skjámyndun og keyrslu...
' "$@" ;;
    is:invalid_backend) printf 'Ógildur PyTorch-bakendi: %s
' "$@" ;;
