    ko:nsis_downloading) printf 'Python, Qt, PyTorch 및 spaCR를 다운로드하는 중입니다. 몇 분 정도 걸릴 수 있습니다.
' "$@" ;;
    ko:nsis_failed) printf 'spaCR 설치가 종료 코드 %s로 실패했습니다. 기존 설치가 있으면 그대로 유지했습니다.
' "$@" ;;
    ko:nsis_gpu) printf '자동 하드웨어 가속(권장)
' "$@" ;;
    ko:nsis_launch) printf 'spaCR 실행
' "$@" ;;
    ko:nsis_uninstall) printf 'spaCR 제거
' "$@" ;;
    ko:option_requires) printf '%s 옵션에는 값이 필요합니다.
' "$@" ;;
    ko:options) printf '옵션
' "$@" ;;
    ko:platform) printf '플랫폼
' "$@" ;;
    ko:private_python) printf '전용 Python 실행 환경
' "$@" ;;
    ko:pytorch_backend) printf 'PyTorch 백엔드
' "$@" ;;
    ko:qt_help) printf 'spaCR가 시작되지 않으면 배포판의 Qt/XCB/OpenGL 런타임 패키지를 설치하세요.
' "$@" ;;
    ko:ready_opening) printf 'spaCR가 준비되었습니다. 애플리케이션을 여는 중...
' "$@" ;;
    ko:removed) printf 'spaCR를 제거했습니다. 사용자가 만든 데이터와 환경 설정은 그대로 유지했습니다.
' "$@" ;;
    ko:required_command) printf '필수 명령을 찾을 수 없습니다: %s
' "$@" ;;
    ko:resolver_guards) printf '의존성 해결 보호 기능
' "$@" ;;
    ko:unknown_option) printf '알 수 없는 옵션: %s
' "$@" ;;
    ko:unknown_package_manager) printf '알 수 없는 Linux 패키지 관리자입니다. 이미 설치된 라이브러리를 사용하여 계속합니다.
' "$@" ;;
    ko:unsafe_root) printf '안전하지 않은 설치 디렉터리를 거부합니다: %s
' "$@" ;;
    ko:unsupported_platform) printf '지원하지 않는 플랫폼입니다. Windows에서는 Windows 온라인 설치 프로그램을 사용하세요.
' "$@" ;;
    ko:unsupported_platform_value) printf '지원하지 않는 플랫폼 값: %s
' "$@" ;;
    ko:usage) printf '사용법: install_spacr_unix.sh [옵션]
' "$@" ;;
    ko:uv_missing) printf 'uv가 예상 경로에 설치되지 않았습니다: %s
' "$@" ;;
    ko:validating_install) printf '활성화하기 전에 설치를 검증하는 중...
' "$@" ;;
    is:already_running) printf 'Uppsetning spaCR er þegar í gangi fyrir þennan notanda.
' "$@" ;;
    is:application) printf 'forrit
' "$@" ;;
    is:available_space) printf 'Aðeins %s GB eru laus nálægt %s.
' "$@" ;;
    is:choose_directory) printf 'Veldu sérstaka möppu fyrir spaCR.
' "$@" ;;
    is:command_failed) printf '%s mistókst með stöðukóðanum %s.
' "$@" ;;
    is:creating_environment) printf 'Bý til einangrað spaCR-umhverfi...
' "$@" ;;
    is:desktop_comment) printf 'Rýmisbundin svipgerðargreining á CRISPR-skimunum
' "$@" ;;
    is:detailed_log) printf 'Ítarleg uppsetningarskrá: %s
' "$@" ;;
    is:downloading_dependencies) printf 'Sæki spaCR, Qt, PyTorch og hugbúnaðarhæði...
' "$@" ;;
    is:downloading_python) printf 'Sæki einkaeintak af Python %s...
' "$@" ;;
    is:downloading_uv) printf 'Sæki fasta útgáfu af uv-ræsiforritinu...
' "$@" ;;
    is:dry_create) printf 'PRUFUKEYRSLA: myndi búa til og staðfesta %s
' "$@" ;;
    is:dry_download) printf 'PRUFUKEYRSLA: myndi sækja %s
' "$@" ;;
    is:dry_launcher) printf 'PRUFUKEYRSLA: myndi setja upp ræsiforritið %s
' "$@" ;;
    is:help_dry_run) printf 'Sýna útfærða áætlun án þess að sækja neitt.
' "$@" ;;
    is:help_help) printf 'Sýna þessa hjálp.
' "$@" ;;
    is:help_install_root) printf 'Setja upp í PATH.
' "$@" ;;
    is:help_launcher_dir) printf 'Setja skipanaræsinn í PATH (aðallega fyrir CI).
' "$@" ;;
    is:help_no_command_launcher) printf 'Ekki setja upp skipanalínuræsi.
' "$@" ;;
    is:help_no_launch) printf 'Ekki ræsa spaCR eftir uppsetningu.
' "$@" ;;
    is:help_package_spec) printf 'Setja SPEC upp í stað útgefinnar spaCR-smíðar.
' "$@" ;;
