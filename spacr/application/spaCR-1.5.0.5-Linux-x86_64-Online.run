' "$@" ;;
    is:needs_free_space) printf 'spaCR þarf að minnsta kosti 5 GB af lausu plássi meðan Python, Qt, PyTorch og háðir pakkar eru settir upp.
' "$@" ;;
    is:no_sudo) printf 'sudo-skipunin fannst ekki. Haldið er áfram án valfrjálsra Linux-safna fyrir Qt.
' "$@" ;;
    is:nsis_application) printf 'spaCR-skjáborðsforrit
' "$@" ;;
    is:nsis_downloading) printf 'Sæki Python, Qt, PyTorch og spaCR. Þetta getur tekið nokkrar mínútur.
' "$@" ;;
    is:nsis_failed) printf 'Uppsetning spaCR mistókst með stöðukóðanum %s. Fyrri uppsetning var varðveitt, ef hún var til.
' "$@" ;;
    is:nsis_gpu) printf 'Sjálfvirk vélbúnaðarhröðun (mælt með)
' "$@" ;;
    is:nsis_launch) printf 'Ræsa spaCR
' "$@" ;;
    is:nsis_uninstall) printf 'Fjarlægja spaCR
' "$@" ;;
