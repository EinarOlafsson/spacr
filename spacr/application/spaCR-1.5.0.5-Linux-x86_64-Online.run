#!/usr/bin/env bash
#
# Small online installer for Linux and macOS.
#
# The file itself contains no Python runtime or scientific dependencies. It
# downloads a pinned uv bootstrap over TLS, lets uv install a private CPython
# 3.12 runtime, then resolves spaCR and the appropriate PyTorch backend.

set -Eeuo pipefail

# @SPACR_INSTALLER_MESSAGES_BEGIN@
# Generated by packaging/i18n/render.py; do not hand-edit.
spacr_install_language() {
  spacr_locale="${SPACR_INSTALL_LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
  if [ -z "$spacr_locale" ] && command -v defaults >/dev/null 2>&1; then
    spacr_locale="$(defaults read -g AppleLocale 2>/dev/null || true)"
  fi
  case "${spacr_locale:-en}" in
    [sS][vV]*) echo sv ;; [dD][eE]*) echo de ;; [eE][sS]*) echo es ;; [zZ][hH]*) echo zh_CN ;;
    [pP][tT]*) echo pt ;; [hH][iI]*) echo hi ;; [kK][oO]*) echo ko ;; [iI][sS]*) echo is ;; [fF][rR]*) echo fr ;;
    *) echo en ;;
  esac
}
SPACR_INSTALL_LANGUAGE_RESOLVED="$(spacr_install_language)"
spacr_say() {
  spacr_key=$1; shift
  case "$SPACR_INSTALL_LANGUAGE_RESOLVED:$spacr_key" in
    en:installer_title) printf 'spaCR lightweight online installer
' "$@" ;;
    en:platform) printf 'platform
' "$@" ;;
    en:application) printf 'application
' "$@" ;;
    en:private_python) printf 'private Python
' "$@" ;;
    en:install_root) printf 'install root
' "$@" ;;
    en:pytorch_backend) printf 'PyTorch backend
' "$@" ;;
    en:resolver_guards) printf 'resolver guards
' "$@" ;;
    en:dry_download) printf 'DRY RUN: would download %s
' "$@" ;;
    en:dry_create) printf 'DRY RUN: would create and validate %s
' "$@" ;;
    en:dry_launcher) printf 'DRY RUN: would install launcher %s
' "$@" ;;
    en:required_command) printf 'Required command not found: %s
' "$@" ;;
    en:needs_free_space) printf 'spaCR needs at least 5 GB free while Python, Qt, PyTorch and dependencies install.
' "$@" ;;
    en:available_space) printf 'Only %s GB is available near %s.
' "$@" ;;
    en:no_sudo) printf 'No sudo command was found. Continuing without optional Linux Qt libraries.
' "$@" ;;
    en:qt_help) printf 'If spaCR does not start, install your distribution'"'"'s Qt/XCB/OpenGL runtime packages.
' "$@" ;;
