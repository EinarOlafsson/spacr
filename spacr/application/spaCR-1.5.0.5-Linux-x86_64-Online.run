' "$@" ;;
    is:options) printf 'Valkostir
' "$@" ;;
    is:platform) printf 'stýrikerfi
' "$@" ;;
    is:private_python) printf 'einkaeintak af Python
' "$@" ;;
    is:pytorch_backend) printf 'PyTorch-bakendi
' "$@" ;;
    is:qt_help) printf 'Ef spaCR ræsist ekki skaltu setja upp keyrslupakka dreifingarinnar fyrir Qt/XCB/OpenGL.
' "$@" ;;
    is:ready_opening) printf 'spaCR er tilbúið. Forritið er ræst...
' "$@" ;;
    is:removed) printf 'spaCR var fjarlægt. Gögn og stillingar sem notandinn bjó til voru látin ósnert.
' "$@" ;;
    is:required_command) printf 'Nauðsynleg skipun fannst ekki: %s
' "$@" ;;
    is:resolver_guards) printf 'varnir við úrlausn háðra pakka
' "$@" ;;
    is:unknown_option) printf 'Óþekktur valkostur: %s
' "$@" ;;
    is:unknown_package_manager) printf 'Óþekktur pakkastjóri fyrir Linux; haldið er áfram með þau söfn sem þegar eru uppsett.
' "$@" ;;
    is:unsafe_root) printf 'Neita að nota óörugga uppsetningarmöppu: %s
' "$@" ;;
    is:unsupported_platform) printf 'Óstutt stýrikerfi. Notaðu Windows-netuppsetningarforritið á Windows.
' "$@" ;;
    is:unsupported_platform_value) printf 'Óstutt gildi fyrir stýrikerfi: %s
