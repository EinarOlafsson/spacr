
# THE INSTRUCTION INDEX IS GENERATED, SO IT IS REBUILT ON MERGE RATHER THAN
# TEXT-MERGED. `tools/build_instruction_index.py` writes it from the folders
# themselves, so the two sides of any merge are two RENDERINGS of state git
# has already merged correctly in instructions/open/ and instructions/done/.
# Choosing between those renderings by hand is the one resolution that can be
# wrong without anyone noticing -- and it conflicted three times in one day
# with two sessions working the same branch.
#
# A merge driver has to be declared in each clone; git does not honour one
# defined in a committed file, deliberately. See instructions/open/
# 325_two_sessions_one_repo_working_protocol.txt for the one-line
# `git config` that installs it.
instructions/00_INDEX.txt merge=spacr-index

# HASH-PINNED EVIDENCE IS CHECKED OUT BYTE FOR BYTE. Feature evidence and the
# published site's sources are pinned by SHA-256, so a core.autocrlf=true
# checkout (Git for Windows' default) that rewrote LF as CRLF would fail them
# on a file nobody changed.
features/data/** -text
docs/source/_extra/** -text
docs/i18n/reviewed/** -text
tools/setting_animation_templates/** -text
tests/data/** -text
tools/repair/*.commit -text

# PACKAGE DATA IS BYTES. Everything under spacr/resources ships in the wheel
# byte for byte, and several files are pinned by SHA-256 (the barcode
# references, the bundled examples). A core.autocrlf=true checkout rewrote
# 78 of them as CRLF on Windows, so a source checkout refused its own
# bundled data as 'not the one this release ships'.
spacr/resources/** -text
